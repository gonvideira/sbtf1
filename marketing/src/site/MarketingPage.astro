    --chart-c3: #043f7f;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: #e0eaf4;
    --chart-surface: #ffffff;
    --chart-deemph: #9db4cb;
    --chart-font: var(--font-ui);

    background: var(--ice);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 1.02rem;
  }

  .shell {
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

