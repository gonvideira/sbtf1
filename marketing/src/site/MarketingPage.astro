    background: rgba(2, 29, 59, 0.5);
  }
  .btn-cta-solid {
    background: #fff;
    color: var(--brand);
  }
  .btn-cta-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(1, 16, 31, 0.5);
  }
  .btn-cta-outline {
    border: 1.5px solid rgba(255, 255, 255, 0.65);
    color: #fff;
  }
  .btn-cta-outline:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* ===== Header ===== */
  .site-header {
