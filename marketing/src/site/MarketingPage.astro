    color: var(--blue);
  }
  .display {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 22ch;
    margin-top: 0.9rem;
  }
  .resources .display::before,
  .fund .display::before {
    content: '';
    display: block;
