---
// BLUE TRANSFORMATION FUND — final marketing site ("Cardume" direction).
// The luminous museum of the sea: the barracuda vortex opens the page, the
// Hub dives into the dolphin canyon, the Fund alternates daylight and abyss —
// thesis in the light, the European context back down in the canyon, the
// NaturaFish estuary filling the frame, structure & terms on deep navy.
// Hero claim: "O mar já é nosso. A escala é o próximo passo."
import '@fontsource-variable/fraunces'
import '@fontsource-variable/ibm-plex-sans'
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import plexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/${locale}/`
const altPath = `/${locale === 'pt' ? 'en' : 'pt'}/`
const isPt = locale === 'pt'

const L = isPt
  ? {
      chartTable: 'Ver dados',
      chartYear: 'Ano',
      chartValue: 'Auto-suficiência',
      heroCredit: 'Cardume de barracudas — o mar que Portugal conhece há séculos.',
      diveCue: 'Mergulhar',
      diveKicker: 'Uma imersão em quatro capítulos',
      resurface: 'De volta à superfície',
      eras: ['Há quinhentos anos', 'Hoje', 'O futuro · 2026 → 2034'] as const,
      eraKicker: 'Regressar ao futuro',
      euKicker: 'Regresso à profundidade',
      partners: 'Ecossistema & Parceiros',
      metrics: 'Métricas do fundo',
      videoPlay: 'Reproduzir vídeo de fundo',
      videoPause: 'Pausar vídeo de fundo',
      navLabel: 'Navegação principal',
      fundNav: 'Secções do fundo',
      legalNav: 'Links legais',
      farmCaption: 'Instalações NaturaFish, estuário do Alvor e Arade — Algarve.',
      canyonAlt: '',
    }
  : {
      chartTable: 'View data',
      chartYear: 'Year',
      chartValue: 'Self-sufficiency',
      heroCredit: 'A school of barracuda — the sea Portugal has known for centuries.',
      diveCue: 'Dive in',
      diveKicker: 'An immersion in four chapters',
      resurface: 'Back to the surface',
      eras: ['Five hundred years ago', 'Today', 'The future · 2026 → 2034'] as const,
      eraKicker: 'Back to the future',
      euKicker: 'Return to the deep',
      partners: 'Ecosystem & Partners',
      metrics: 'Fund metrics',
      videoPlay: 'Play background video',
      videoPause: 'Pause background video',
      navLabel: 'Main navigation',
      fundNav: 'Fund sections',
      legalNav: 'Legal links',
      farmCaption: 'NaturaFish facilities, Alvor and Arade estuaries — Algarve.',
      canyonAlt: '',
    }

const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#F2F7FC"
  bodyClass="alt-a"
>
  <Fragment slot="head">
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/media/fish-vortex-poster.jpg" as="image" fetchpriority="high" />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image class="logo logo-light" src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={185} densities={[1, 2]} loading="eager" fetchpriority="high" />
        <Image class="logo logo-dark" src={brand.logoNavy} alt="" aria-hidden="true" width={185} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={L.navLabel}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ 1 · HERO — the vortex ============ -->
    <section class="hero" id="hero" data-scene>
      <div class="hero-media">
        <video
          data-ambient
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster="/media/fish-vortex-poster.jpg"
          width="1920"
          height="1078"
          aria-hidden="true"
        >
          <source data-src="/media/fish-vortex.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source data-src="/media/fish-vortex.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="hero-veil" aria-hidden="true"></div>
      </div>
      <div class="shell hero-content">
        <p class="kicker rise" style="--d:0ms">{t.hero.kicker}</p>
        <h1 class="hero-headline">
          <span class="hl-1 rise" style="--d:140ms">{t.hero.headlineLine1}</span>
          <span class="hl-2 rise" style="--d:380ms">{t.hero.headlineLine2}</span>
        </h1>
        <p class="hero-sub rise" style="--d:580ms">{t.hero.subheadline}</p>
        <div class="hero-ctas rise" style="--d:740ms">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
          <a class="btn btn-glass" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label} <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-credit rise" style="--d:900ms">{L.heroCredit}</p>
      </div>
      <a class="scroll-cue" href="#stats" aria-label={L.diveCue}>
        <span class="cue-ring" aria-hidden="true"></span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <!-- stat band — hard navy block -->
    <section class="stats" id="stats" aria-label={L.metrics}>
      <div class="shell">
        <dl class="stat-band">
          {t.statBar.stats.map((s) => (
            <div class="stat reveal">
              <dd data-count>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="footnote footnote-dark">{t.statBar.irrCaveat}</p>
      </div>
    </section>

    <!-- ============ 2 · HUB — the dive ============ -->
    <section class="dive" id="hub" aria-labelledby="hub-title" data-scrub>
      <div class="dive-media" aria-hidden="true">
        <video
          data-ambient
          muted
          loop
          playsinline
          preload="none"
          data-poster="/media/dolphin-deep-poster.jpg"
          width="1920"
          height="1080"
        >
          <source data-src="/media/dolphin-deep.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source data-src="/media/dolphin-deep.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="dive-veil"></div>
        <p class="dive-depth mono-num" aria-hidden="true"><span data-depth-out data-depth-max="1000">−0 m</span></p>
      </div>

      <div class="dive-chapters">
        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <div class="glass glass-intro" data-parallax="0.06">
              <p class="chapter-kicker">{L.diveKicker}</p>
              <h2 id="hub-title" class="dive-display">{t.hub.title}</h2>
              <p class="dive-lede">{t.hub.intro}</p>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <h3 class="chapter-label" data-parallax="0.05">{t.hub.statCardsTitle}</h3>
            <div class="glass-grid">
              {t.hub.statCards.map((s, i) => (
                <article class="glass glass-stat" data-parallax={String(0.02 + (i % 4) * 0.02)}>
                  <p class="g-value" data-count>{s.value}</p>
                  <p class="g-label">{s.label}</p>
                  <p class="g-source">
                    {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                    {s.asOf && <span> · {s.asOf}</span>}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <div class="glass glass-chart" data-parallax="0.05">
              <h3 class="g-title">{t.hub.chart.title}</h3>
              <p class="g-sub">{t.hub.chart.subtitle}</p>
              <LineChart
                data={euSelfSufficiency}
                locale={locale}
                yMin={30}
                yMax={50}
                yUnit="%"
                summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
                tableLabel={L.chartTable}
                yearLabel={L.chartYear}
                valueLabel={L.chartValue}
              >
                <span slot="caption">{t.hub.chart.sourceNote}</span>
              </LineChart>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <aside class="glass glass-obs" aria-labelledby="obs-title" data-research-slot data-parallax="0.05">
              <div class="obs-head">
                <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
                <p class="obs-updated"><span class="obs-pulse" aria-hidden="true"></span>{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
              </div>
              <div class="obs-grid">
                {research.map((s) => (
                  <article class="obs-card">
                    <p class="g-value g-value-sm">{s.value}</p>
                    <p class="g-label">{s.label}</p>
                    <p class="g-source"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
                  </article>
                ))}
              </div>
              <p class="obs-note">{t.hub.researchSlot.note}</p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- resurface: resources — marked cut back into the light -->
    <section class="resources" aria-label={t.hub.resourcesTitle}>
      <div class="shell">
        <p class="kicker kicker-ink reveal">{L.resurface}</p>
        <h2 class="display reveal">{t.hub.resourcesTitle}</h2>
        <div class="resource-grid">
          {t.hub.resourceCards.map((c) => (
            <article class="resource-card reveal">
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              <ul class="resource-links">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {l.label} {l.external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 3 · THE FUND — daylight and abyss ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <nav class="fund-subnav" aria-label={L.fundNav}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s) => (
              <li><a href={s.anchor}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis as three eras -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <p class="kicker kicker-ink reveal">{L.eraKicker}</p>
          <h2 id="thesis-title" class="display reveal">{t.fund.thesis.title}</h2>
          <div class="eras">
            {t.fund.thesis.paragraphs.map((p, i) => (
              <div class="era reveal" data-scene>
                <div class="era-rail" aria-hidden="true"><span class="era-node"></span></div>
                <div class="era-body">
                  <p class="era-label">{L.eras[i]}</p>
                  <p class={`era-copy ${i === 0 ? 'drop-cap' : ''}`}>{p}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="equation reveal" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
            {t.fund.thesis.equation.blocks.map((b, i) => (
              <>
                <span class="eq-block">{b}</span>
                <span class="eq-op" aria-hidden="true">{i < 2 ? '+' : '='}</span>
              </>
            ))}
            <span class="eq-result">{t.fund.thesis.equation.result}</span>
          </div>
        </div>
      </article>

      <!-- European context — the return to the canyon -->
      <article class="eu-band" aria-labelledby="eu-title" data-scene>
        <div class="eu-media" data-parallax="0.12">
          <Picture
            src={photos.canyonStill}
            alt={L.canyonAlt}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </div>
        <div class="eu-veil" aria-hidden="true"></div>
        <div class="shell eu-content">
          <p class="kicker reveal">{L.euKicker}</p>
          <h3 id="eu-title" class="eu-title reveal">{t.fund.euContext.title}</h3>
          <p class="eu-intro reveal">{t.fund.euContext.intro}</p>
          <div class="eu-grid">
            {t.fund.euContext.stats.map((s, i) => (
              <div class="glass eu-stat reveal" data-parallax={String(0.03 + (i % 4) * 0.02)}>
                <p class="eu-value" data-count>{s.value}</p>
                <p class="eu-label">{s.label}</p>
                <p class="eu-source">{s.source}</p>
              </div>
            ))}
          </div>
        </div>
      </article>

      <!-- Verticals -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <h2 id="verticals-title" class="display reveal">{t.fund.verticals.title}</h2>
          <p class="lede reveal">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap reveal">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="vertical-list">
            {t.fund.verticals.items.map((v) => (
              <section class="vertical reveal" aria-labelledby={`v-${v.number}`}>
                <div class="v-head">
                  <span class="v-no">{v.number}</span>
                  <div>
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-alloc">{v.allocationLabel}</p>
                  </div>
                </div>
                <p class="v-copy">{v.copy}</p>
                <ul class="v-bullets">
                  {v.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio — the estuary fills the frame -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title" data-scene>
        <div class="pf-band">
          <div class="pf-media" data-parallax="0.14">
            <Picture
              src={photos.naturafishPan}
              alt={t.fund.portfolio.imageAlt}
              widths={[768, 1280, 1920]}
              sizes="100vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
          </div>
          <div class="pf-veil" aria-hidden="true"></div>
          <div class="shell pf-content">
            <h2 id="portfolio-title" class="display display-inverse reveal">{t.fund.portfolio.title}</h2>
            <div class="pf-body reveal">
              <p class="anchor-tag">{t.fund.portfolio.anchorTag}</p>
              <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
              <p class="anchor-copy">{t.fund.portfolio.copy}</p>
              <div class="farm-cards">
                {t.fund.portfolio.farms.map((f) => (
                  <div class="farm-card">
                    <p class="farm-name">{f.name}</p>
                    <p class="farm-specs">{f.specs}</p>
                  </div>
                ))}
              </div>
              <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
              <p class="pf-credit">{L.farmCaption}</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Structure & Terms — deep navy block -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <h2 id="terms-title" class="display display-inverse reveal">{t.fund.terms.title}</h2>
          <dl class="terms-table reveal">
            {t.fund.terms.rows.map((r) => (
              <div class="terms-row">
                <dt>{r.label}</dt>
                <dd>
                  <span class="terms-value" data-count>{r.value}</span>
                  {r.caveat && <span class="terms-caveat">{r.caveat}</span>}
                </dd>
              </div>
            ))}
          </dl>
          <p class="manager-line reveal">{t.fund.terms.managerLine}</p>
          <p class="footnote footnote-dark reveal">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <h2 id="team-title" class="display reveal">{t.fund.team.title}</h2>
          {t.fund.team.groups.map((g) => (
            <section class="team-group" aria-label={g.title}>
              <h3 class="sub-label reveal">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member reveal">
                    {m.photo && teamPhotos[m.photo] ? (
                      <Image
                        class="member-photo"
                        src={teamPhotos[m.photo]!}
                        alt={m.name}
                        width={400}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    ) : (
                      <div class="member-monogram" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span aria-hidden="true">{m.name.split(' ').map((w) => w[0]).filter((_, i, a) => i === 0 || i === a.length - 1).join('')}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <h2 id="process-title" class="display reveal">{t.fund.process.title}</h2>
          <p class="lede reveal">{t.fund.process.intro}</p>
          <ol class="steps reveal">
            {t.fund.process.steps.map((s, i) => (
              <li class="step">
                <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.description}</p>
              </li>
            ))}
          </ol>
          <div class="invest-cta reveal">
            <div class="contact-card">
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role">{t.fund.process.contact.role}</p>
              <p class="contact-line"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line contact-general"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-cta-solid" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary} <span aria-hidden="true">→</span></a>
              <a class="btn btn-cta-outline" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary} <span aria-hidden="true">→</span></a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={L.partners}>
      <div class="shell">
        <h2 class="sub-label reveal">{L.partners}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={44} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-info">
        <nav class="footer-links" aria-label={L.legalNav}>
          <ul>
            {t.footer.links.map((l) => (
              <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <div class="footer-logo-wrap">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={120} densities={[1, 2]} loading="lazy" />
      </div>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens — every hue derived from the logo navy #043F7F ===== */
  :global(body.alt-a) {
