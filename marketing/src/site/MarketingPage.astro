  /* ===== The dive ===== */
  .dive {
    position: relative;
    background: var(--deep);
    border-top: 1px solid rgba(111, 165, 220, 0.35);
  }
  .dive-media {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .dive-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1 + var(--p, 0) * 0.18));
    transform-origin: center 60%;
    transition: transform 0.1s linear;
  }
  .dive-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--deep) 0%, rgba(2, 29, 59, 0) 7%),
