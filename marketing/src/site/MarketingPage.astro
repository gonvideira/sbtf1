<script>
  import { initImmersive } from '@/scripts/immersive'
  initImmersive()

  // header switches from over-video (light) to solid once past the hero
  const setScrolled = () => {
    if (window.scrollY > window.innerHeight * 0.7) document.body.dataset.scrolled = 'true'
