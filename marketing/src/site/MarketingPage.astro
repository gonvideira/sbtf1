      align-items: flex-start;
      padding-block: 14vh 8vh;
    }
  }

  .glass-chart {
    max-width: 56rem;
    margin-inline: auto;
    padding: clamp(1.6rem, 3.5vw, 2.4rem);
    --chart-surface: rgba(2, 29, 59, 0.001);
    --chart-ink: #eaf2fb;
    --chart-ink-muted: #9fbedc;
    --chart-grid: rgba(111, 165, 220, 0.22);
