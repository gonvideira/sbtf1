    background: currentColor;
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
