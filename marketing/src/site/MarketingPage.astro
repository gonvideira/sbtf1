---
// BLUE TRANSFORMATION FUND — the Hub da Economia Azul landing page.
// The luminous museum of the sea: the barracuda vortex opens the page and the
// Hub dives into the dolphin canyon, resurfacing into the sector resources and
// the Fundos rail. The fund's own seven chapters live on FundPage.astro.
// Hero claim: "Crescer com o Mar — dar escala à economia azul."
import '@fontsource-variable/fraunces'
import '@fontsource-variable/ibm-plex-sans'
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import plexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { observatoryHref } from '@/data/observatory'
import { brand, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/${locale}/`
const altPath = `/${locale === 'pt' ? 'en' : 'pt'}/`
const isPt = locale === 'pt'

const fund = t.funds[0]

// Anchors that used to live on this page and now live on the fund page. The
// inline head script below sends any bookmarked/linked one straight there.
const legacyFundHashes = [
  '#fundo',
  '#tese',
  '#verticais',
  '#portfolio',
  '#sustentabilidade',
  '#estrutura',
  '#equipa',
  '#investir',
]

const L = isPt
  ? {
      chartTable: 'Ver dados',
      chartYear: 'Ano',
      chartValue: 'Auto-suficiência',
      heroCredit: 'Cardume de barracudas — o mar que Portugal conhece há séculos.',
      diveCue: 'Mergulhar',
      resurface: 'De volta à superfície',
      partners: 'Ecossistema & Parceiros',
      metrics: 'Métricas do fundo',
      videoPlay: 'Reproduzir vídeo de fundo',
      videoPause: 'Pausar vídeo de fundo',
      navLabel: 'Navegação principal',
      legalNav: 'Links legais',
    }
  : {
      chartTable: 'View data',
      chartYear: 'Year',
      chartValue: 'Self-sufficiency',
      heroCredit: 'A school of barracuda — the sea Portugal has known for centuries.',
      diveCue: 'Dive in',
      resurface: 'Back to the surface',
      partners: 'Ecosystem & Partners',
      metrics: 'Fund metrics',
      videoPlay: 'Play background video',
      videoPause: 'Pause background video',
      navLabel: 'Main navigation',
      legalNav: 'Legal links',
    }
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.hub.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#F2F7FC"
  bodyClass="alt-a"
>
  <Fragment slot="head">
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/media/fish-vortex-poster.jpg" as="image" fetchpriority="high" />
    {/* The fund's chapters moved to their own page; anything still pointing at
        the old anchors is redirected before paint so no one lands on nothing. */}
    <script is:inline define:vars={{ legacyFundHashes, fundPath: fund.path }}>
      var legacyHash = window.location.hash
      if (legacyHash && legacyFundHashes.indexOf(legacyHash) !== -1) {
        window.location.replace(fundPath + (legacyHash === '#fundo' ? '' : legacyHash))
      }
    </script>
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image class="logo logo-light" src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={185} densities={[1, 2]} loading="eager" fetchpriority="high" />
        <Image class="logo logo-dark" src={brand.logoNavy} alt="" aria-hidden="true" width={185} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={L.navLabel}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-investor-item">
            <span class="nav-investor">
              {t.nav.investorArea.label}
              <span class="nav-investor-badge">{t.nav.investorArea.badge}</span>
            </span>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ 1 · HERO — the vortex ============ -->
    <section class="hero" id="hero" data-scene>
      <div class="hero-media">
        <video
          data-ambient
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster="/media/fish-vortex-poster.jpg"
          width="1920"
          height="1072"
          aria-hidden="true"
        >
          <source data-src="/media/fish-vortex.av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
          <source data-src="/media/fish-vortex.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="hero-veil" aria-hidden="true"></div>
      </div>
      <div class="shell hero-content">
        <p class="kicker rise" style="--d:0ms">{t.hero.kicker}</p>
        <h1 class="hero-headline">
          <span class="hl-1 rise" style="--d:140ms">{t.hero.headlineLine1}</span>
          <span class="hl-2 rise" style="--d:380ms">{t.hero.headlineLine2}</span>
        </h1>
        <p class="hero-sub rise" style="--d:580ms">{t.hero.subheadline}</p>
        <div class="hero-ctas rise" style="--d:740ms">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
          <a class="btn btn-glass" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label} <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-credit rise" style="--d:900ms">{L.heroCredit}</p>
      </div>
      <a class="scroll-cue" href="#hub" aria-label={L.diveCue}>
        <span class="cue-ring" aria-hidden="true"></span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <!-- ============ 2 · HUB — the dive ============ -->
    <section class="dive" id="hub" aria-labelledby="hub-title" data-scrub>
      <div class="dive-media" aria-hidden="true">
        <video
          data-ambient
          muted
          loop
          playsinline
          preload="none"
          data-poster="/media/dolphin-deep-poster.jpg"
          width="1920"
          height="1080"
        >
          <source data-src="/media/dolphin-deep.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source data-src="/media/dolphin-deep.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="dive-veil"></div>
        <p class="dive-depth mono-num" aria-hidden="true"><span data-depth-out data-depth-max="1000">−0 m</span></p>
      </div>

      <div class="dive-chapters">
        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <div class="glass glass-intro" data-parallax="0.06">
              <h2 id="hub-title" class="dive-display">{t.hub.title}</h2>
              <p class="dive-lede">{t.hub.intro}</p>
              <p class="dive-contribute">
                {t.hub.contribution.prompt}{' '}
                <a href={`mailto:${t.hub.contribution.email}`}>{t.hub.contribution.email}</a>
              </p>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <h3 class="chapter-label" data-parallax="0.05">{t.hub.statCardsTitle}</h3>
            <div class="glass-grid">
              {t.hub.statCards.map((s, i) => (
                <article class="glass glass-stat" data-parallax={String(0.02 + (i % 4) * 0.02)}>
                  <p class="g-value" data-count>{s.value}</p>
                  <p class="g-label">{s.label}</p>
                  <p class="g-source">
                    {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                    {s.asOf && <span> · {s.asOf}</span>}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell chapter-inner">
            <div class="dive-duo" data-parallax="0.05">
              <div class="glass glass-chart">
                <h3 class="g-title">{t.hub.chart.title}</h3>
                <p class="g-sub">{t.hub.chart.subtitle}</p>
                <LineChart
                  data={euSelfSufficiency}
                  locale={locale}
                  orientation="vertical"
                  yMin={30}
                  yMax={50}
                  yUnit="%"
                  summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
                  tableLabel={L.chartTable}
                  yearLabel={L.chartYear}
                  valueLabel={L.chartValue}
                >
                  <span slot="caption">{t.hub.chart.sourceNote}</span>
                </LineChart>
              </div>

              <aside class="glass glass-obs" aria-labelledby="obs-title" data-research-slot>
                <div class="obs-head">
                  <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
                  <p class="obs-updated"><span class="obs-pulse" aria-hidden="true"></span>{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
                </div>
                <div class="obs-grid">
                  {research.map((s) => (
                    <article class="obs-card">
                      <p class="g-value g-value-sm">{s.value}</p>
                      <p class="g-label">{s.label}</p>
                      <p class="g-source"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
                    </article>
                  ))}
                </div>
                <p class="obs-note">{t.hub.researchSlot.note}</p>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- resurface: resources — marked cut back into the light -->
    <section class="resources" id="recursos" aria-label={t.hub.resourcesTitle}>
      <div class="shell">
        <p class="kicker kicker-ink reveal">{L.resurface}</p>
        <h2 class="display reveal">{t.hub.resourcesTitle}</h2>
        <div class="resource-grid">
          {t.hub.resourceCards.map((c) => (
            <article class="resource-card resource-card--page reveal">
              <h3><a class="rc-page-link" href={observatoryHref(c.category, locale)}>{c.title}</a></h3>
              <p>{c.description}</p>
              <p class="resource-cta" aria-hidden="true">
                {c.pageLabel} <span>→</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 3 · FUNDOS — the platform's funds, teased from the hub ============ -->
    <section class="funds-rail" id="fundos" aria-label={t.hub.fundsRail.label}>
      <div class="shell">
        <h2 class="display reveal">{t.hub.fundsRail.title}</h2>
        <div class="fund-rail-grid">
          <article class="fund-card reveal">
            <p class="fc-no">{fund.teaser.number}</p>
            <h3 class="fc-name"><a class="fc-link" href={fund.path}>{fund.teaser.name}</a></h3>
            <p class="fc-blurb">{fund.teaser.blurb}</p>
            <p class="fc-terms">{fund.teaser.terms}</p>
            <p class="fc-manager">{fund.terms.managerLine}</p>
            <p class="fc-cta" aria-hidden="true">
              {t.hub.fundsRail.ctaLabel} <span>→</span>
            </p>
          </article>
        </div>
        <!-- the ¹ in the terms strip resolves here, on the same page (regulatory) -->
        <p class="footnote reveal">{fund.terms.irrCaveat}</p>
      </div>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={L.partners}>
      <div class="shell">
        <h2 class="sub-label reveal">{L.partners}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={44} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-info">
        <nav class="footer-links" aria-label={L.legalNav}>
          <ul>
            {t.footer.links.map((l) => (
              <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <div class="footer-logo-wrap">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={120} densities={[1, 2]} loading="lazy" />
      </div>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens — every hue derived from the logo navy #043F7F ===== */
  :global(body.alt-a) {
    --brand: #043f7f;
    --deep: #021d3b;
    --abyss: #01101f;
    --blue: #1a5ea8;
    --sky: #6fa5dc;
    --pale: #a9caec;
    --mist: #dce9f6;
    --ice: #f2f7fc;
    --ink: #0a2036;
    --ink-soft: #3a5470;
    --ink-muted: #58708a;
    --hairline: #d8e4f0;
    --hairline-strong: #b9cde1;
    --font-display: 'Fraunces Variable', Georgia, serif;
    --font-ui: 'IBM Plex Sans Variable', system-ui, sans-serif;

    --chart-line: #1a5ea8;
    --chart-c1: #6fa5dc;
    --chart-c2: #2e6cb5;
    --chart-c3: #043f7f;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: #e0eaf4;
    --chart-surface: #ffffff;
    --chart-deemph: #9db4cb;
    --chart-font: var(--font-ui);

    background: var(--ice);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 1.02rem;
  }

  .shell {
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  .kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--sky);
  }
  .kicker-ink {
    color: var(--blue);
  }
  .display {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 22ch;
    margin-top: 0.9rem;
  }
  .resources .display::before,
  .funds-rail .display::before {
    content: '';
    display: block;
    width: 56px;
    height: 4px;
    background: var(--brand);
    margin-bottom: 1.1rem;
  }
  .sub-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 3rem 0 1.2rem;
  }
  .footnote {
    font-size: 0.75rem;
    color: var(--ink-muted);
    max-width: 72ch;
    margin-top: 0.9rem;
  }
  .mono-num {
    font-variant-numeric: tabular-nums;
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 650;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.9rem 1.7rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .btn-solid {
    background: #fff;
    color: var(--brand);
  }
  .btn-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(2, 29, 59, 0.35);
  }
  .btn-glass {
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: #fff;
    background: rgba(2, 29, 59, 0.25);
    backdrop-filter: blur(8px);
  }
  .btn-glass:hover {
    background: rgba(2, 29, 59, 0.5);
  }

  /* ===== Header ===== */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    transition: background 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  :global(body.alt-a[data-scrolled]) .site-header {
    background: rgba(242, 247, 252, 0.92);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }
  .logo {
    width: clamp(140px, 16vw, 185px);
    height: auto;
  }
  .logo-dark {
    display: none;
  }
  :global(body.alt-a[data-scrolled]) .logo-light {
    display: none;
  }
  :global(body.alt-a[data-scrolled]) .logo-dark {
    display: block;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 550;
  }
  .nav-list a {
    text-decoration: none;
    color: #fff;
  }
  :global(body.alt-a[data-scrolled]) .nav-list a {
    color: var(--ink-soft);
  }
  .nav-list a:hover {
    color: var(--sky) !important;
  }
  .nav-lang a {
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  /* Investor area — placeholder until the gated area is built, so it is
     deliberately inert: no href, dimmed, and badged "soon". */
  .nav-investor {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.62);
    cursor: default;
  }
  :global(body.alt-a[data-scrolled]) .nav-investor {
    color: rgba(3, 32, 63, 0.5);
  }
  .nav-investor-badge {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.16rem 0.42rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.85;
    white-space: nowrap;
  }
  .nav-cta {
    background: #fff;
    color: var(--brand) !important;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    font-weight: 700;
  }
  :global(body.alt-a[data-scrolled]) .nav-cta {
    background: var(--brand);
    color: #fff !important;
  }
  .nav-toggle {
    display: none;
    background: rgba(2, 29, 59, 0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    color: #fff;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  :global(body.alt-a[data-scrolled]) .nav-toggle {
    background: #fff;
    color: var(--ink);
    border-color: var(--hairline);
  }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-toggle-bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
  }
  /* Collapses at 1100px rather than 900px: with the investor-area item the bar
     no longer fits between ~900 and ~1100, where the label wrapped to two lines. */
  @media (max-width: 1100px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--ice);
      border-bottom: 1px solid var(--hairline);
      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid var(--hairline);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
      color: var(--ink-soft) !important;
    }
    .nav-investor {
      display: flex;
      padding: 0.9rem 0.25rem;
      color: rgba(3, 32, 63, 0.5) !important;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
      background: var(--brand);
      color: #fff !important;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero — quieter, more elegant scale ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
