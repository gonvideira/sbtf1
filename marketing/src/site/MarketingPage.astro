      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid var(--hairline);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
      color: var(--ink-soft) !important;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
      background: var(--brand);
      color: #fff !important;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero — quieter, more elegant scale ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 29, 59, 0.42) 0%,
      rgba(2, 29, 59, 0.12) 38%,
      rgba(2, 29, 59, 0.6) 74%,
      var(--deep) 100%
    );
  }
  .video-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 3;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(2, 29, 59, 0.45);
    backdrop-filter: blur(6px);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .video-toggle:hover {
    background: rgba(2, 29, 59, 0.7);
  }
  .vt-pause,
  .vt-play {
    grid-area: 1 / 1;
  }
  .vt-pause {
    width: 10px;
    height: 12px;
    border-left: 3px solid #fff;
    border-right: 3px solid #fff;
  }
  .vt-play {
    width: 0;
    height: 0;
    border-left: 11px solid #fff;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    display: none;
    margin-left: 2px;
  }
  .video-toggle[data-state='paused'] .vt-pause {
    display: none;
  }
  .video-toggle[data-state='paused'] .vt-play {
    display: block;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: clamp(7rem, 16vh, 11rem);
    padding-bottom: clamp(6rem, 13vh, 9rem);
  }
  .hero-headline {
    margin-top: 1.3rem;
