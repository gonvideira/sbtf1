    letter-spacing: 0.002em;
    color: #fff;
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(2, 29, 59, 0.45);
  }
  .hero-headline .hl-1,
  .hero-headline .hl-2 {
    display: block;
  }
  .hero-headline .hl-2 {
