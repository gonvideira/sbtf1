    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.65);
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    text-decoration: none;
  }
  .cue-ring {
    grid-area: 1/1;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    animation: cue-breathe 2.6s ease-in-out infinite;
  }
  .cue-arrow {
    grid-area: 1/1;
    color: #fff;
    font-size: 1rem;
  }
  @keyframes cue-breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.18); opacity: 0.55; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-ring { animation: none; }
  }

  .rise {
    opacity: 0;
    transform: translateY(26px);
    animation: rise 0.9s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* ===== Stats — a solid navy block, hard edges ===== */
  .stats {
    background: var(--deep);
    padding-block: clamp(2.4rem, 5vw, 3.8rem);
  }
  .stat-band {
    display: grid;
