---
// ALTERNATIVE B — "CORRENTE PROFUNDA"
// Creative thesis: a descent. The page begins at the sunlit surface — the
// real Algarve estuary — and sinks through progressively deeper water as the
// reader scrolls: hub at snorkel depth, thesis and fund mechanics in open
// water, the closing commitment at the sea floor. Depth markers annotate the
// journey; light behaves like light underwater (caustic drift, luminous
// data). Cinematic and modern — the register of a top-tier infrastructure
// fund — while every number keeps its regulatory footing.
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/inter'
import spaceGroteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/b/${locale}/`
const altPath = `/b/${locale === 'pt' ? 'en' : 'pt'}/`

const isPt = locale === 'pt'
const chartTableLabel = isPt ? 'Ver dados' : 'View data'
const chartYearLabel = isPt ? 'Ano' : 'Year'
const chartValueLabel = isPt ? 'Auto-suficiência' : 'Self-sufficiency'
const heroCaption = isPt
  ? 'Instalações NaturaFish, estuário do Alvor e Arade — Algarve, Portugal.'
  : 'NaturaFish facilities, Alvor and Arade estuaries — Algarve, Portugal.'
const partnersTitle = isPt ? 'Ecossistema & Parceiros' : 'Ecosystem & Partners'
const scrollCue = isPt ? 'Descer' : 'Descend'
const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))

// Depth annotations for the descent narrative
const depths = {
  hub: '−12 m',
  thesis: '−40 m',
  verticals: '−80 m',
  portfolio: '−120 m',
  terms: '−200 m',
  team: '−400 m',
  invest: '−1.000 m',
}
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#071A33"
  bodyClass="alt-b"
>
  <Fragment slot="head">
    <link rel="preload" href={spaceGroteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={180} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={isPt ? 'Navegação principal' : 'Main navigation'}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ SURFACE · HERO ============ -->
    <section class="hero" id="hero">
      <div class="hero-media" aria-hidden="true">
        <Picture
          src={photos.naturafishWide}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-veil"></div>
        <div class="caustic caustic-1"></div>
        <div class="caustic caustic-2"></div>
      </div>
      <div class="shell hero-content">
        <p class="kicker reveal">{t.hero.kicker}</p>
        <h1 class="hero-headline reveal">
          <span class="hl-1">{t.hero.headlineLine1}</span>
          <span class="hl-2">{t.hero.headlineLine2}</span>
        </h1>
        <p class="hero-sub reveal">{t.hero.subheadline}</p>
        <div class="hero-ctas reveal">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label}</a>
          <a class="btn btn-ghost" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label}</a>
        </div>
        <p class="hero-credit reveal">{heroCaption}</p>
      </div>
      <a class="scroll-cue" href="#stats" aria-label={scrollCue}>
        <span class="cue-label">{scrollCue}</span>
        <span class="cue-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- stat band -->
    <section class="stats" id="stats" aria-label={isPt ? 'Métricas do fundo' : 'Fund metrics'}>
      <div class="shell">
        <dl class="stat-band">
          {t.statBar.stats.map((s) => (
            <div class="stat reveal">
              <dd data-count>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="footnote">{t.statBar.irrCaveat}</p>
      </div>
    </section>

    <!-- ============ HUB ============ -->
    <section class="hub" id="hub" aria-labelledby="hub-title">
      <div class="shell">
        <div class="depth-mark reveal"><span class="depth-value">{depths.hub}</span><span class="depth-rule"></span><span class="depth-label">{t.hub.sectionLabel}</span></div>
        <h2 id="hub-title" class="display reveal">{t.hub.title}</h2>
        <p class="lede reveal">{t.hub.intro}</p>

        <h3 class="sub-label reveal">{t.hub.statCardsTitle}</h3>
        <div class="hub-grid">
          {t.hub.statCards.map((s) => (
            <article class="hub-card reveal">
              <p class="hub-value">{s.value}</p>
              <p class="hub-label">{s.label}</p>
              <p class="hub-source">
                {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                {s.asOf && <span> · {s.asOf}</span>}
              </p>
            </article>
          ))}
        </div>

        <div class="hub-chart reveal">
          <div class="hub-chart-text">
            <h3 class="chart-title">{t.hub.chart.title}</h3>
            <p class="chart-sub">{t.hub.chart.subtitle}</p>
          </div>
          <LineChart
            data={euSelfSufficiency}
            locale={locale}
            yMin={30}
            yMax={50}
            yUnit="%"
            summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
            tableLabel={chartTableLabel}
            yearLabel={chartYearLabel}
            valueLabel={chartValueLabel}
          >
            <span slot="caption">{t.hub.chart.sourceNote}</span>
          </LineChart>
        </div>

        <!-- Research slot (swappable module fed by /research) -->
        <aside class="observatory reveal" aria-labelledby="obs-title" data-research-slot>
          <div class="obs-head">
            <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
            <p class="obs-updated"><span class="obs-pulse" aria-hidden="true"></span>{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
          </div>
          <div class="obs-grid">
            {research.map((s) => (
              <article class="obs-card">
                <p class="obs-value">{s.value}</p>
                <p class="obs-label">{s.label}</p>
                <p class="obs-source"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
              </article>
            ))}
          </div>
          <p class="obs-note">{t.hub.researchSlot.note}</p>
        </aside>

        <h3 class="sub-label reveal">{t.hub.resourcesTitle}</h3>
        <div class="resource-grid">
          {t.hub.resourceCards.map((c) => (
            <article class="resource-card reveal">
              <h4>{c.title}</h4>
              <p>{c.description}</p>
              <ul class="resource-links">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {l.label} {l.external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE FUND ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <nav class="fund-subnav" aria-label={isPt ? 'Secções do fundo' : 'Fund sections'}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s) => (
              <li><a href={s.anchor}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <div class="depth-mark reveal"><span class="depth-value">{depths.thesis}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.thesis.sectionLabel}</span></div>
          <h2 id="thesis-title" class="display reveal">{t.fund.thesis.title}</h2>
          <div class="thesis-cols">
            <div class="thesis-body">
              <p class="reveal">{t.fund.thesis.paragraphs[0]}</p>
              <p class="reveal">{t.fund.thesis.paragraphs[1]}</p>
              <p class="reveal">{t.fund.thesis.paragraphs[2]}</p>
            </div>
            <div class="equation" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
              {t.fund.thesis.equation.blocks.map((b, i) => (
                <>
                  <div class="eq-block reveal" style={`transition-delay:${i * 120}ms`}>{b}</div>
                  <div class="eq-op reveal" aria-hidden="true" style={`transition-delay:${i * 120 + 60}ms`}>{i < 2 ? '+' : '='}</div>
                </>
              ))}
              <div class="eq-result reveal" style="transition-delay:420ms">{t.fund.thesis.equation.result}</div>
            </div>
          </div>

          <div class="eu-context reveal">
            <h3 class="eu-title">{t.fund.euContext.title}</h3>
            <p class="eu-intro">{t.fund.euContext.intro}</p>
            <div class="eu-grid">
              {t.fund.euContext.stats.map((s) => (
                <div class="eu-stat">
                  <p class="eu-value">{s.value}</p>
                  <p class="eu-label">{s.label}</p>
                  <p class="eu-source">{s.source}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Verticals -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <div class="depth-mark reveal"><span class="depth-value">{depths.verticals}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.verticals.sectionLabel}</span></div>
          <h2 id="verticals-title" class="display reveal">{t.fund.verticals.title}</h2>
          <p class="lede reveal">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap reveal">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="vertical-cards">
            {t.fund.verticals.items.map((v) => (
              <section class="v-card reveal" aria-labelledby={`v-${v.number}`}>
                <div class="v-top">
                  <span class="v-no" aria-hidden="true">{v.number}</span>
                  <div class="v-titles">
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-alloc">{v.allocationLabel}</p>
                  </div>
                </div>
                <div class="v-meter" aria-hidden="true"><span style={`--pct:${v.allocationPct}%`}></span></div>
                <p class="v-copy">{v.copy}</p>
                <ul class="v-bullets">
                  {v.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title">
        <div class="portfolio-band">
          <Picture
            src={photos.naturafishPan}
            alt={t.fund.portfolio.imageAlt}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
          <div class="band-veil" aria-hidden="true"></div>
        </div>
        <div class="shell portfolio-content">
          <div class="depth-mark reveal"><span class="depth-value">{depths.portfolio}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.portfolio.sectionLabel}</span></div>
          <h2 id="portfolio-title" class="display reveal">{t.fund.portfolio.title}</h2>
          <div class="portfolio-card reveal">
            <p class="anchor-tag">{t.fund.portfolio.anchorTag}</p>
            <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
            <p class="anchor-copy">{t.fund.portfolio.copy}</p>
            <div class="farm-cards">
              {t.fund.portfolio.farms.map((f) => (
                <div class="farm-card">
                  <p class="farm-name">{f.name}</p>
                  <p class="farm-specs">{f.specs}</p>
                </div>
              ))}
            </div>
            <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
          </div>
        </div>
      </article>

      <!-- Structure & Terms -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <div class="depth-mark reveal"><span class="depth-value">{depths.terms}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.terms.sectionLabel}</span></div>
          <h2 id="terms-title" class="display reveal">{t.fund.terms.title}</h2>
          <div class="terms-grid">
            {t.fund.terms.rows.map((r) => (
              <div class="terms-card reveal">
                <p class="terms-label">{r.label}</p>
                <p class="terms-value">{r.value}</p>
                {r.caveat && <p class="terms-caveat">{r.caveat}</p>}
              </div>
            ))}
          </div>
          <p class="manager-line reveal">{t.fund.terms.managerLine}</p>
          <p class="footnote reveal">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <div class="depth-mark reveal"><span class="depth-value">{depths.team}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.team.sectionLabel}</span></div>
          <h2 id="team-title" class="display reveal">{t.fund.team.title}</h2>
          {t.fund.team.groups.map((g) => (
            <section class="team-group" aria-label={g.title}>
              <h3 class="sub-label reveal">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member reveal">
                    {m.photo && teamPhotos[m.photo] ? (
                      <div class="member-photo-wrap">
                        <Image
                          class="member-photo"
                          src={teamPhotos[m.photo]!}
                          alt={m.name}
                          width={400}
                          densities={[1, 2]}
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="member-monogram" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span aria-hidden="true">{m.name.split(' ').map((w) => w[0]).filter((_, i, a) => i === 0 || i === a.length - 1).join('')}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <div class="depth-mark reveal"><span class="depth-value">{depths.invest}</span><span class="depth-rule"></span><span class="depth-label">{t.fund.process.sectionLabel}</span></div>
          <h2 id="process-title" class="display reveal">{t.fund.process.title}</h2>
          <p class="lede reveal">{t.fund.process.intro}</p>
          <ol class="steps">
            {t.fund.process.steps.map((s, i) => (
              <li class="step reveal">
                <span class="step-dot" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="step-title">{s.title}</h3>
                  <p class="step-desc">{s.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="invest-cta reveal">
            <div class="contact-card">
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role">{t.fund.process.contact.role}</p>
              <p class="contact-line"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line contact-general"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-solid" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary}</a>
              <a class="btn btn-ghost" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary}</a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={partnersTitle}>
      <div class="shell">
        <h2 class="sub-label reveal">{partnersTitle}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={40} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={200} densities={[1, 2]} loading="lazy" />
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <nav class="footer-links" aria-label={isPt ? 'Links legais' : 'Legal links'}>
        <ul>
          {t.footer.links.map((l) => (
            <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens ===== */
  :global(body.alt-b) {
    --surface-0: #0a2140; /* hub */
    --deep: #071a33; /* base */
    --deeper: #05142a;
    --abyss: #030d1d;
    --panel: rgba(20, 51, 92, 0.45);
    --panel-line: rgba(110, 168, 220, 0.22);
    --ink: #eaf3fb;
    --ink-soft: #c2d4e6;
    --ink-muted: #8fa9c4;
    --cyan: #2ec4ce;
    --cyan-soft: #6fd3dc;
    --gold: #e8b54e;
    --font-display: 'Space Grotesk Variable', system-ui, sans-serif;
    --font-body: 'Inter Variable', system-ui, sans-serif;

    --chart-line: #3a87d0;
    --chart-c1: #3a87d0;
    --chart-c2: #12939e;
    --chart-c3: #c1861d;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: rgba(143, 169, 196, 0.18);
    --chart-surface: var(--surface-0);
    --chart-deemph: #5c7ea0;
    --chart-tooltip-bg: rgba(234, 243, 251, 0.95);
    --chart-tooltip-ink: #071a33;
    --chart-font: var(--font-body);

    background: var(--deep);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.03rem;
  }

  .shell {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  .kicker {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cyan-soft);
  }
  .display {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 24ch;
    margin-top: 1rem;
  }
  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 64ch;
    margin-top: 1.1rem;
  }
  .sub-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 3rem 0 1.2rem;
  }
  .footnote {
    font-size: 0.75rem;
    color: var(--ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
  }
  .depth-mark {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(3.5rem, 8vw, 6rem);
    font-family: var(--font-display);
  }
  .depth-value {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    font-variant-numeric: tabular-nums;
  }
  .depth-rule {
    flex: 0 0 56px;
    height: 1px;
    background: var(--panel-line);
  }
  .depth-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 6px;
    padding: 0.9rem 1.7rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .btn-solid {
    background: var(--cyan);
    color: #04121f;
    box-shadow: 0 0 24px rgba(46, 196, 206, 0.35);
  }
  .btn-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 36px rgba(46, 196, 206, 0.55);
  }
  .btn-ghost {
    border: 1px solid var(--panel-line);
    color: var(--ink);
    background: rgba(7, 26, 51, 0.35);
    backdrop-filter: blur(6px);
  }
  .btn-ghost:hover {
    border-color: var(--cyan-soft);
    color: var(--cyan-soft);
  }

  /* ===== Header ===== */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    background: linear-gradient(rgba(3, 13, 29, 0.85), rgba(3, 13, 29, 0.55) 70%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(110, 168, 220, 0.12);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .logo-link img {
    width: clamp(132px, 15vw, 180px);
    height: auto;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav-list a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .nav-list a:hover {
    color: var(--cyan-soft);
  }
  .nav-lang a {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
  }
  .nav-cta {
    background: var(--cyan);
    color: #04121f !important;
    padding: 0.55rem 1.1rem;
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .nav-cta:hover {
    box-shadow: 0 0 20px rgba(46, 196, 206, 0.5);
  }
  .nav-toggle {
    display: none;
    background: rgba(7, 26, 51, 0.5);
    border: 1px solid var(--panel-line);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink);
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-toggle-bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--abyss);
      border-bottom: 1px solid var(--panel-line);
      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid rgba(110, 168, 220, 0.1);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7, 26, 51, 0.55) 0%, rgba(7, 26, 51, 0.25) 34%, rgba(7, 26, 51, 0.72) 72%, var(--deep) 98%),
      radial-gradient(120% 60% at 70% 10%, rgba(46, 196, 206, 0.12), transparent 60%);
  }
  .caustic {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.16;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .caustic-1 {
    background: radial-gradient(circle, #2ec4ce 0%, transparent 62%);
    top: -25%;
    left: -12%;
    animation: drift1 26s ease-in-out infinite alternate;
  }
  .caustic-2 {
    background: radial-gradient(circle, #1a5b9a 0%, transparent 60%);
    bottom: -30%;
    right: -15%;
    animation: drift2 32s ease-in-out infinite alternate;
  }
  @keyframes drift1 {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(9vw, 6vh) scale(1.15); }
  }
  @keyframes drift2 {
    from { transform: translate(0, 0) scale(1.1); }
    to { transform: translate(-8vw, -5vh) scale(0.95); }
  }
  @media (prefers-reduced-motion: reduce) {
    .caustic {
      animation: none;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: clamp(7rem, 16vh, 11rem);
    padding-bottom: clamp(5rem, 12vh, 8rem);
  }
  .hero-headline {
    margin-top: 1.3rem;
    font-family: var(--font-display);
    font-weight: 640;
    font-size: clamp(2.05rem, 5.2vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    max-width: 21ch;
    text-wrap: balance;
  }
  .hero-headline .hl-1,
  .hero-headline .hl-2 {
    display: block;
  }
  .hero-headline .hl-2 {
    margin-top: 0.2em;
    background: linear-gradient(92deg, var(--cyan-soft), #9be3ea 60%, var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .hero-credit {
    margin-top: 2.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .scroll-cue {
    position: absolute;
    right: clamp(1.25rem, 4vw, 2.5rem);
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .cue-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-muted);
    writing-mode: vertical-rl;
  }
  .cue-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(var(--cyan-soft), transparent);
    animation: cue 2.2s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.55); opacity: 0.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-line { animation: none; }
  }

  /* ===== Stats ===== */
  .stats {
    background: var(--deep);
    padding-block: clamp(2.2rem, 5vw, 3.6rem);
  }
  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    margin: 0;
  }
  .stat {
    border-left: 2px solid var(--cyan);
    padding-left: 1.1rem;
  }
  .stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-weight: 640;
    margin: 0;
    color: var(--ink);
    text-shadow: 0 0 28px rgba(46, 196, 206, 0.35);
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }
  @media (max-width: 760px) {
    .stat-band {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ===== Hub ===== */
  .hub {
    background: linear-gradient(var(--deep), var(--surface-0) 14%, var(--surface-0) 86%, var(--deeper));
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .hub-card {
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 1.3rem 1.2rem 1.1rem;
    backdrop-filter: blur(4px);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .hub-card:hover {
    border-color: rgba(46, 196, 206, 0.5);
    transform: translateY(-3px);
  }
  .hub-value {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 640;
    color: var(--cyan-soft);
    font-variant-numeric: tabular-nums;
  }
  .hub-label {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .hub-source {
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.7rem;
  }
  .hub-source a {
    color: inherit;
  }
  .hub-source a:hover {
    color: var(--cyan-soft);
  }
  @media (max-width: 980px) {
    .hub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
  }

  .hub-chart {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 3rem;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 12px;
  }
  .chart-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .chart-sub {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-top: 0.6rem;
  }
  .hub-chart :global(.lc-line) {
    filter: drop-shadow(0 0 7px rgba(58, 135, 208, 0.65));
  }
  .hub-chart :global(figure) {
    --chart-surface: #10305a;
  }
  @media (max-width: 820px) {
    .hub-chart {
      grid-template-columns: 1fr;
    }
  }

  /* Observatory / research slot */
  .observatory {
    margin-top: 3rem;
    border: 1px solid rgba(46, 196, 206, 0.4);
    background: linear-gradient(140deg, rgba(46, 196, 206, 0.08), rgba(26, 91, 154, 0.08));
    border-radius: 12px;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }
  .obs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .obs-head h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }
  .obs-updated {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .obs-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 0 rgba(46, 196, 206, 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from { box-shadow: 0 0 0 0 rgba(46, 196, 206, 0.6); }
    to { box-shadow: 0 0 0 12px rgba(46, 196, 206, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .obs-pulse { animation: none; }
  }
  .obs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem 2rem;
    margin-top: 1.6rem;
  }
  .obs-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 640;
    color: var(--cyan-soft);
    font-variant-numeric: tabular-nums;
  }
  .obs-label {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.3rem;
  }
  .obs-source {
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.45rem;
  }
  .obs-source a {
    color: inherit;
  }
  .obs-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-top: 1.6rem;
    max-width: 72ch;
  }
  @media (max-width: 880px) {
    .obs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .obs-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Resource cards */
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .resource-card {
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 1.2rem;
  }
  .resource-card h4 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-soft);
  }
  .resource-card p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
  .resource-links {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .resource-links a {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration-color: rgba(110, 168, 220, 0.4);
  }
  .resource-links a:hover {
    color: var(--cyan-soft);
  }
  @media (max-width: 880px) {
    .resource-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== Fund ===== */
  .fund {
    background: linear-gradient(var(--deeper), var(--deep) 30%, var(--deeper) 75%, var(--abyss));
  }
  .fund-subnav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(3, 13, 29, 0.82);
    backdrop-filter: blur(10px);
    border-block: 1px solid rgba(110, 168, 220, 0.12);
  }
  .fund-subnav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.2rem);
    list-style: none;
    padding: 0.7rem 0;
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .fund-subnav a {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .fund-subnav a:hover {
    color: var(--cyan-soft);
  }

  .thesis,
  .verticals,
  .terms,
  .team,
  .process {
    padding-bottom: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 70px;
  }

  .thesis-cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 2rem;
    align-items: start;
  }
  .thesis-body p {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: 1.3rem;
    max-width: 58ch;
  }
  .equation {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: sticky;
    top: 90px;
  }
  .eq-block {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    border: 1px solid var(--panel-line);
    background: var(--panel);
    border-radius: 8px;
    padding: 0.95rem 1.2rem;
  }
  .eq-op {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--cyan-soft);
    padding-left: 1.2rem;
  }
  .eq-result {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    background: linear-gradient(120deg, rgba(46, 196, 206, 0.25), rgba(26, 91, 154, 0.35));
    border: 1px solid rgba(46, 196, 206, 0.55);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    box-shadow: 0 0 32px rgba(46, 196, 206, 0.15);
  }
  @media (max-width: 880px) {
    .thesis-cols {
      grid-template-columns: 1fr;
    }
    .equation {
      position: static;
    }
  }

  .eu-context {
    margin-top: clamp(2.6rem, 6vw, 4rem);
    border-top: 1px solid rgba(110, 168, 220, 0.14);
    padding-top: 2.4rem;
  }
  .eu-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 600;
    max-width: 30ch;
  }
  .eu-intro {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    max-width: 64ch;
    line-height: 1.65;
  }
  .eu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  .eu-stat {
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 1.2rem;
  }
  .eu-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 640;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .eu-label {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .eu-source {
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.5rem;
  }
  @media (max-width: 820px) {
    .eu-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .eu-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Verticals */
  .alloc-wrap {
    margin-top: 2.2rem;
    max-width: 48rem;
  }
  .vertical-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-top: 2.6rem;
  }
  .v-card {
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 14px;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .v-card:hover {
    border-color: rgba(46, 196, 206, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgba(3, 13, 29, 0.5);
  }
  .v-top {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .v-no {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: rgba(111, 211, 220, 0.28);
    line-height: 1;
  }
  .v-titles h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .v-alloc {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--cyan-soft);
    margin-top: 0.4rem;
  }
  .v-meter {
    height: 4px;
    border-radius: 2px;
    background: rgba(110, 168, 220, 0.15);
    overflow: hidden;
  }
  .v-meter span {
    display: block;
    height: 100%;
    width: var(--pct);
    border-radius: 2px;
    background: linear-gradient(90deg, var(--cyan), #3a87d0);
  }
  .v-copy {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
