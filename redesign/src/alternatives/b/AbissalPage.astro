---
// ALTERNATIVE B — "ABISSAL"
// Creative thesis: one continuous dive. The visitor enters at the sunlit
// vortex and never resurfaces: every scroll takes them deeper — a live depth
// gauge reads out the descent, marine snow drifts past, the dolphin canyon
// carries the Hub, and the Fund plays out on the sea floor as a heritage
// story told in eras ("regressar ao futuro"): five centuries of know-how
// lighting the way to 2034. The most cinematic of the three — data glows
// like bioluminescence against logo-navy depths.
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/ibm-plex-sans'
import spaceGroteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'
import plexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/b/${locale}/`
const altPath = `/b/${locale === 'pt' ? 'en' : 'pt'}/`
const isPt = locale === 'pt'

const L = isPt
  ? {
      chartTable: 'Ver dados',
      chartYear: 'Ano',
      chartValue: 'Auto-suficiência',
      heroCredit: 'Cardume de barracudas ao largo — luz de superfície.',
      cue: 'Iniciar a descida',
      surface: 'Superfície',
      diveKicker: 'Profundidade · o hub',
      eras: ['1500', 'Hoje', '2034'] as const,
      eraLabels: ['Há quinhentos anos', 'O presente', 'Regressar ao futuro'] as const,
      eraKicker: 'No fundo do mar, a história',
      partners: 'Ecossistema & Parceiros',
      metrics: 'Métricas do fundo',
      videoPlay: 'Reproduzir vídeo de fundo',
      videoPause: 'Pausar vídeo de fundo',
      navLabel: 'Navegação principal',
      fundNav: 'Secções do fundo',
      legalNav: 'Links legais',
      farmCaption: 'Instalações NaturaFish, estuário do Alvor e Arade — Algarve.',
    }
  : {
      chartTable: 'View data',
      chartYear: 'Year',
      chartValue: 'Self-sufficiency',
      heroCredit: 'A school of barracuda offshore — surface light.',
      cue: 'Begin the descent',
      surface: 'Surface',
      diveKicker: 'Depth · the hub',
      eras: ['1500', 'Today', '2034'] as const,
      eraLabels: ['Five hundred years ago', 'The present', 'Back to the future'] as const,
      eraKicker: 'On the sea floor, the story',
      partners: 'Ecosystem & Partners',
      metrics: 'Fund metrics',
      videoPlay: 'Play background video',
      videoPause: 'Pause background video',
      navLabel: 'Main navigation',
      fundNav: 'Fund sections',
      legalNav: 'Legal links',
      farmCaption: 'NaturaFish facilities, Alvor and Arade estuaries — Algarve.',
    }

const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#021D3B"
  bodyClass="alt-b"
>
  <Fragment slot="head">
    <link rel="preload" href={spaceGroteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/media/fish-vortex-poster.jpg" as="image" fetchpriority="high" />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={180} densities={[1, 2]} loading="eager" fetchpriority="high" />
      </a>
      <nav class="main-nav" aria-label={L.navLabel}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ SURFACE · HERO ============ -->
    <section class="hero" id="hero" data-scene>
      <div class="hero-media">
        <video
          data-ambient
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster="/media/fish-vortex-poster.jpg"
          width="1920"
          height="1078"
          aria-hidden="true"
        >
          <source data-src="/media/fish-vortex.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source data-src="/media/fish-vortex.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="hero-veil" aria-hidden="true"></div>
      </div>
      <p class="surface-tag mono-num" aria-hidden="true">0 m — {L.surface}</p>
      <div class="shell hero-content">
        <p class="kicker rise" style="--d:0ms">{t.hero.kicker}</p>
        <h1 class="hero-headline">
          <span class="hl-1 rise" style="--d:140ms">{t.hero.headlineLine1}</span>
          <span class="hl-2 rise" style="--d:360ms">{t.hero.headlineLine2}</span>
        </h1>
        <p class="hero-sub rise" style="--d:560ms">{t.hero.subheadline}</p>
        <div class="hero-ctas rise" style="--d:720ms">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label}</a>
          <a class="btn btn-ghost" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label}</a>
        </div>
        <p class="hero-credit rise" style="--d:880ms">{L.heroCredit}</p>
      </div>
      <a class="scroll-cue" href="#stats" aria-label={L.cue}>
        <span class="cue-label">{L.cue}</span>
        <span class="cue-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- sinking stat band -->
    <section class="stats" id="stats" aria-label={L.metrics}>
      <div class="shell">
        <dl class="stat-band">
          {t.statBar.stats.map((s) => (
            <div class="stat reveal">
              <dd data-count>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="footnote">{t.statBar.irrCaveat}</p>
      </div>
    </section>

    <!-- ============ THE DESCENT · HUB ============ -->
    <section class="dive" id="hub" aria-labelledby="hub-title" data-scrub>
      <div class="dive-media" aria-hidden="true">
        <video
          data-ambient
          muted
          loop
          playsinline
          preload="none"
          data-poster="/media/dolphin-deep-poster.jpg"
          width="1600"
          height="900"
        >
          <source src="/media/dolphin-deep.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source src="/media/dolphin-deep.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="dive-veil"></div>
        <div class="snow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="gauge" aria-hidden="true">
          <span class="gauge-line"></span>
          <span class="gauge-read mono-num" data-depth-out data-depth-max="1000">−0 m</span>
        </div>
      </div>

      <div class="dive-chapters">
        <div class="chapter" data-scene>
          <div class="shell">
            <div class="panel panel-intro" data-parallax="0.07">
              <p class="chapter-kicker">{L.diveKicker}</p>
              <h2 id="hub-title" class="dive-display">{t.hub.title}</h2>
              <p class="dive-lede">{t.hub.intro}</p>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell">
            <h3 class="chapter-label" data-parallax="0.04">{t.hub.statCardsTitle}</h3>
            <div class="panel-grid">
              {t.hub.statCards.map((s, i) => (
                <article class="panel panel-stat" data-parallax={String(0.02 + (i % 4) * 0.02)}>
                  <p class="p-value" data-count>{s.value}</p>
                  <p class="p-label">{s.label}</p>
                  <p class="p-source">
                    {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                    {s.asOf && <span> · {s.asOf}</span>}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell">
            <div class="panel panel-chart" data-parallax="0.06">
              <h3 class="p-title">{t.hub.chart.title}</h3>
              <p class="p-sub">{t.hub.chart.subtitle}</p>
              <LineChart
                data={euSelfSufficiency}
                locale={locale}
                yMin={30}
                yMax={50}
                yUnit="%"
                summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
                tableLabel={L.chartTable}
                yearLabel={L.chartYear}
                valueLabel={L.chartValue}
              >
                <span slot="caption">{t.hub.chart.sourceNote}</span>
              </LineChart>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <div class="shell">
            <aside class="panel panel-obs" aria-labelledby="obs-title" data-research-slot data-parallax="0.06">
              <div class="obs-head">
                <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
                <p class="obs-updated"><span class="obs-pulse" aria-hidden="true"></span>{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
              </div>
              <div class="obs-grid">
                {research.map((s) => (
                  <article class="obs-card">
                    <p class="p-value p-value-sm">{s.value}</p>
                    <p class="p-label">{s.label}</p>
                    <p class="p-source"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
                  </article>
                ))}
              </div>
              <p class="obs-note">{t.hub.researchSlot.note}</p>
            </aside>
          </div>
        </div>

        <div class="chapter chapter-resources" data-scene>
          <div class="shell">
            <h3 class="chapter-label">{t.hub.resourcesTitle}</h3>
            <div class="resource-grid">
              {t.hub.resourceCards.map((c) => (
                <article class="panel resource-card">
                  <h4>{c.title}</h4>
                  <p>{c.description}</p>
                  <ul class="resource-links">
                    {c.links.map((l) => (
                      <li>
                        <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                          {l.label} {l.external && <span aria-hidden="true">↗</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SEA FLOOR · THE FUND ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <nav class="fund-subnav" aria-label={L.fundNav}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s) => (
              <li><a href={s.anchor}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis as eras with giant watermarks -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <p class="kicker reveal">{L.eraKicker}</p>
          <h2 id="thesis-title" class="display reveal">{t.fund.thesis.title}</h2>
        </div>
        <div class="eras">
          {t.fund.thesis.paragraphs.map((p, i) => (
            <div class="era" data-scene>
              <span class="era-mark" aria-hidden="true" data-parallax="0.12">{L.eras[i]}</span>
              <div class="shell era-inner">
                <div class="era-body reveal">
                  <p class="era-label">{L.eraLabels[i]}</p>
                  <p class="era-copy">{p}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="shell">
          <div class="equation reveal" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
            {t.fund.thesis.equation.blocks.map((b, i) => (
              <>
                <div class="eq-block" style={`transition-delay:${i * 110}ms`}>{b}</div>
                <div class="eq-op" aria-hidden="true">{i < 2 ? '+' : '='}</div>
              </>
            ))}
            <div class="eq-result">{t.fund.thesis.equation.result}</div>
          </div>

          <div class="eu-context reveal">
            <h3 class="eu-title">{t.fund.euContext.title}</h3>
            <p class="eu-intro">{t.fund.euContext.intro}</p>
            <div class="eu-grid">
              {t.fund.euContext.stats.map((s) => (
                <div class="eu-stat">
                  <p class="eu-value" data-count>{s.value}</p>
                  <p class="eu-label">{s.label}</p>
                  <p class="eu-source">{s.source}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Verticals -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <h2 id="verticals-title" class="display reveal">{t.fund.verticals.title}</h2>
          <p class="lede reveal">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap reveal">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="vertical-cards">
            {t.fund.verticals.items.map((v) => (
              <section class="v-card reveal" aria-labelledby={`v-${v.number}`}>
                <div class="v-top">
                  <span class="v-no" aria-hidden="true">{v.number}</span>
                  <div class="v-titles">
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-alloc">{v.allocationLabel}</p>
                  </div>
                </div>
                <div class="v-meter" aria-hidden="true"><span style={`--pct:${v.allocationPct}%`}></span></div>
                <p class="v-copy">{v.copy}</p>
                <ul class="v-bullets">
                  {v.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title" data-scene>
        <div class="portfolio-band">
          <div class="band-media" data-parallax="0.16">
            <Picture
              src={photos.naturafishPan}
              alt={t.fund.portfolio.imageAlt}
              widths={[768, 1280, 1920]}
              sizes="100vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
          </div>
          <div class="band-veil" aria-hidden="true"></div>
        </div>
        <div class="shell portfolio-content">
          <h2 id="portfolio-title" class="display reveal">{t.fund.portfolio.title}</h2>
          <div class="portfolio-card reveal">
            <p class="anchor-tag">{t.fund.portfolio.anchorTag}</p>
            <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
            <p class="anchor-copy">{t.fund.portfolio.copy}</p>
            <div class="farm-cards">
              {t.fund.portfolio.farms.map((f) => (
                <div class="farm-card">
                  <p class="farm-name">{f.name}</p>
                  <p class="farm-specs">{f.specs}</p>
                </div>
              ))}
            </div>
            <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
          </div>
        </div>
      </article>

      <!-- Structure & Terms -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <h2 id="terms-title" class="display reveal">{t.fund.terms.title}</h2>
          <div class="terms-grid">
            {t.fund.terms.rows.map((r) => (
              <div class="terms-card reveal">
                <p class="terms-label">{r.label}</p>
                <p class="terms-value" data-count>{r.value}</p>
                {r.caveat && <p class="terms-caveat">{r.caveat}</p>}
              </div>
            ))}
          </div>
          <p class="manager-line reveal">{t.fund.terms.managerLine}</p>
          <p class="footnote reveal">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <h2 id="team-title" class="display reveal">{t.fund.team.title}</h2>
          {t.fund.team.groups.map((g) => (
            <section class="team-group" aria-label={g.title}>
              <h3 class="sub-label reveal">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member reveal">
                    {m.photo && teamPhotos[m.photo] ? (
                      <div class="member-photo-wrap">
                        <Image
                          class="member-photo"
                          src={teamPhotos[m.photo]!}
                          alt={m.name}
                          width={400}
                          densities={[1, 2]}
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="member-monogram" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span aria-hidden="true">{m.name.split(' ').map((w) => w[0]).filter((_, i, a) => i === 0 || i === a.length - 1).join('')}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <h2 id="process-title" class="display reveal">{t.fund.process.title}</h2>
          <p class="lede reveal">{t.fund.process.intro}</p>
          <ol class="steps">
            {t.fund.process.steps.map((s, i) => (
              <li class="step reveal">
                <span class="step-dot" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="step-title">{s.title}</h3>
                  <p class="step-desc">{s.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="invest-cta reveal">
            <div class="contact-card">
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role">{t.fund.process.contact.role}</p>
              <p class="contact-line"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line contact-general"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-solid" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary}</a>
              <a class="btn btn-ghost" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary}</a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={L.partners}>
      <div class="shell">
        <h2 class="sub-label reveal">{L.partners}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={40} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-info">
        <nav class="footer-links" aria-label={L.legalNav}>
          <ul>
            {t.footer.links.map((l) => (
              <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <div class="footer-logo-wrap">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={120} densities={[1, 2]} loading="lazy" />
      </div>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens — depths of the logo navy #043F7F ===== */
  :global(body.alt-b) {
    --brand: #043f7f;
    --deep: #021d3b;
    --deeper: #011528;
    --abyss: #000a14;
    --shelf: #0a3a6c;
    --panel-bg: rgba(4, 63, 127, 0.28);
    --panel-line: rgba(111, 165, 220, 0.26);
    --ink: #e6f0fa;
    --ink-soft: #c6daee;
    --ink-muted: #7fa3c6;
    --sky: #6fa5dc;
    --pale: #a9caec;
    --font-display: 'Space Grotesk Variable', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans Variable', system-ui, sans-serif;

    --chart-line: #6fa5dc;
    --chart-c1: #a9caec;
    --chart-c2: #6fa5dc;
    --chart-c3: #3d7ec6;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: rgba(127, 163, 198, 0.2);
    --chart-surface: #04264c;
    --chart-deemph: #5c7ea0;
    --chart-tooltip-bg: rgba(230, 240, 250, 0.95);
    --chart-tooltip-ink: #021d3b;
    --chart-font: var(--font-body);

    background: var(--deep);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.02rem;
  }

  .shell {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  .mono-num {
    font-variant-numeric: tabular-nums;
  }

  .kicker {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--pale);
  }
  .display {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 24ch;
    margin-top: 0.9rem;
  }
  .lede {
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 64ch;
    margin-top: 1.1rem;
  }
  .sub-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 3rem 0 1.2rem;
  }
  .footnote {
    font-size: 0.75rem;
    color: var(--ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 8px;
    padding: 0.9rem 1.7rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, border-color 0.22s ease;
  }
  .btn-solid {
    background: var(--pale);
    color: #04264c;
    box-shadow: 0 0 30px rgba(169, 202, 236, 0.35);
  }
  .btn-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 44px rgba(169, 202, 236, 0.55);
  }
  .btn-ghost {
    border: 1px solid var(--panel-line);
    color: var(--ink);
    background: rgba(2, 29, 59, 0.4);
    backdrop-filter: blur(6px);
  }
  .btn-ghost:hover {
    border-color: var(--pale);
    color: var(--pale);
  }

  /* ===== Header ===== */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    background: linear-gradient(rgba(0, 10, 20, 0.88), rgba(0, 10, 20, 0.5) 75%, transparent);
    backdrop-filter: blur(8px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .logo-link img {
    width: clamp(132px, 15vw, 180px);
    height: auto;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav-list a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .nav-list a:hover {
    color: var(--pale);
  }
  .nav-lang a {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--pale);
  }
  .nav-cta {
    background: var(--pale);
    color: #04264c !important;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .nav-cta:hover {
    box-shadow: 0 0 22px rgba(169, 202, 236, 0.5);
  }
  .nav-toggle {
    display: none;
    background: rgba(2, 29, 59, 0.55);
    border: 1px solid var(--panel-line);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink);
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-toggle-bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--abyss);
      border-bottom: 1px solid var(--panel-line);
      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid rgba(111, 165, 220, 0.12);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 29, 59, 0.5) 0%,
      rgba(2, 29, 59, 0.16) 36%,
      rgba(2, 29, 59, 0.68) 76%,
      var(--deep) 100%
    );
  }
  .surface-tag {
    position: absolute;
    right: clamp(1rem, 3vw, 2.2rem);
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    z-index: 1;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(230, 240, 250, 0.6);
  }
  .video-toggle {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 3;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(230, 240, 250, 0.5);
    background: rgba(2, 29, 59, 0.5);
    backdrop-filter: blur(6px);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .video-toggle:hover {
    background: rgba(2, 29, 59, 0.78);
  }
  .vt-pause,
  .vt-play {
    grid-area: 1 / 1;
  }
  .vt-pause {
    width: 10px;
    height: 12px;
    border-left: 3px solid #fff;
    border-right: 3px solid #fff;
  }
  .vt-play {
    width: 0;
    height: 0;
    border-left: 11px solid #fff;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    display: none;
    margin-left: 2px;
  }
  .video-toggle[data-state='paused'] .vt-pause {
    display: none;
  }
  .video-toggle[data-state='paused'] .vt-play {
    display: block;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: clamp(7rem, 16vh, 11rem);
    padding-bottom: clamp(5.5rem, 13vh, 8.5rem);
  }
  .hero-headline {
    margin-top: 1.3rem;
    font-family: var(--font-display);
    font-weight: 640;
    font-size: clamp(2.05rem, 5.2vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    max-width: 21ch;
    text-wrap: balance;
  }
  .hero-headline .hl-1,
  .hero-headline .hl-2 {
    display: block;
  }
  .hero-headline .hl-2 {
    margin-top: 0.2em;
    background: linear-gradient(92deg, var(--pale), #d9e9f8 55%, var(--sky));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    margin-top: 1.5rem;
    font-size: clamp(1.02rem, 1.7vw, 1.26rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .hero-credit {
    margin-top: 2.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .scroll-cue {
    position: absolute;
    right: clamp(1.25rem, 4vw, 2.5rem);
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .cue-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-muted);
    writing-mode: vertical-rl;
  }
  .cue-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(var(--pale), transparent);
    animation: cue 2.2s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.55); opacity: 0.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-line { animation: none; }
  }
  @media (max-width: 760px) {
    .surface-tag,
    .scroll-cue,
    .gauge {
      display: none;
    }
  }

  .rise {
    opacity: 0.01;
    transform: translateY(26px);
    animation: rise 0.9s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* ===== Stats ===== */
  .stats {
    padding-block: clamp(2.2rem, 5vw, 3.6rem);
    background: var(--deep);
  }
  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    margin: 0;
  }
  .stat {
    border-left: 2px solid var(--sky);
    padding-left: 1.1rem;
  }
  .stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-weight: 640;
    margin: 0;
    color: var(--ink);
    text-shadow: 0 0 30px rgba(111, 165, 220, 0.45);
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }
  @media (max-width: 760px) {
    .stat-band {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ===== The descent ===== */
  .dive {
    position: relative;
    background: var(--deeper);
    border-top: 1px solid rgba(111, 165, 220, 0.35);
  }
  .dive-media {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .dive-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1 + var(--p, 0) * 0.22));
    transform-origin: center 58%;
  }
  .dive-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--deep) 0%, rgba(2, 29, 59, 0) 16%),
      linear-gradient(0deg, var(--deeper) 0%, rgba(1, 21, 40, 0) 14%),
      radial-gradient(130% 90% at 50% 50%, transparent 42%, rgba(0, 10, 20, 0.6) 100%);
  }
  /* marine snow */
  .snow i {
    position: absolute;
    top: -4%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(214, 232, 248, 0.5);
    animation: snowfall linear infinite;
  }
  .snow i:nth-child(1) { left: 8%; animation-duration: 15s; animation-delay: 0s; }
  .snow i:nth-child(2) { left: 21%; animation-duration: 21s; animation-delay: 3s; width: 2px; height: 2px; }
  .snow i:nth-child(3) { left: 34%; animation-duration: 17s; animation-delay: 7s; }
  .snow i:nth-child(4) { left: 47%; animation-duration: 24s; animation-delay: 1s; width: 2px; height: 2px; }
  .snow i:nth-child(5) { left: 58%; animation-duration: 16s; animation-delay: 9s; }
  .snow i:nth-child(6) { left: 69%; animation-duration: 22s; animation-delay: 5s; width: 4px; height: 4px; }
  .snow i:nth-child(7) { left: 81%; animation-duration: 18s; animation-delay: 11s; width: 2px; height: 2px; }
  .snow i:nth-child(8) { left: 92%; animation-duration: 20s; animation-delay: 2s; }
  @keyframes snowfall {
    to { transform: translateY(110vh); }
  }
  @media (prefers-reduced-motion: reduce) {
    .snow { display: none; }
  }
  /* depth gauge */
  .gauge {
    position: absolute;
    left: clamp(0.9rem, 2.5vw, 2rem);
    top: 14%;
    bottom: 14%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .gauge-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(rgba(169, 202, 236, 0.05), rgba(169, 202, 236, 0.55) calc(var(--p, 0) * 100%), rgba(169, 202, 236, 0.08) calc(var(--p, 0) * 100% + 1px));
  }
  .gauge-read {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pale);
    text-shadow: 0 0 16px rgba(111, 165, 220, 0.6);
    white-space: nowrap;
  }
  .dive .video-toggle {
    bottom: auto;
    top: clamp(4.6rem, 9vh, 6rem);
    left: auto;
    right: clamp(1rem, 3vw, 2rem);
  }

  .dive-chapters {
    position: relative;
    margin-top: -100svh;
    z-index: 1;
  }
  .chapter {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 10vh;
  }
  .chapter-kicker {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--pale);
  }
  .chapter-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
    text-shadow: 0 1px 14px rgba(0, 10, 20, 0.9);
  }

  .panel {
    background: rgba(1, 21, 40, 0.78);
    border: 1px solid var(--panel-line);
    border-radius: 14px;
    backdrop-filter: blur(10px);
    box-shadow: 0 34px 90px rgba(0, 10, 20, 0.55);
  }
  .panel-intro {
    max-width: 42rem;
    padding: clamp(1.8rem, 4vw, 2.8rem);
  }
  .dive-display {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.07;
    margin-top: 0.9rem;
    color: #fff;
  }
  .dive-lede {
    margin-top: 1.1rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .panel-stat {
    padding: 1.2rem 1.2rem 1.1rem;
  }
  .p-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 640;
    color: var(--pale);
    text-shadow: 0 0 22px rgba(111, 165, 220, 0.4);
    font-variant-numeric: tabular-nums;
  }
  .p-value-sm {
    font-size: 1.45rem;
  }
  .p-label {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }
  .p-source {
    font-size: 0.7rem;
    color: var(--ink-muted);
    margin-top: 0.6rem;
  }
  .p-source a {
    color: inherit;
  }
  .p-source a:hover {
    color: var(--pale);
  }
  @media (max-width: 980px) {
    .panel-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .panel-grid {
      grid-template-columns: 1fr;
    }
    .chapter {
      align-items: flex-start;
      padding-block: 13vh 8vh;
    }
  }

  .panel-chart {
    max-width: 56rem;
    margin-inline: auto;
    padding: clamp(1.6rem, 3.5vw, 2.4rem);
    --chart-surface: rgba(1, 21, 40, 0.01);
  }
  .panel-chart :global(.lc-line) {
    filter: drop-shadow(0 0 8px rgba(111, 165, 220, 0.7));
  }
  .p-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 620;
    color: #fff;
  }
  .p-sub {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0.4rem 0 1.2rem;
  }

  .panel-obs {
    padding: clamp(1.6rem, 3.5vw, 2.4rem);
    border-color: rgba(169, 202, 236, 0.45);
  }
  .obs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .obs-head h3 {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 620;
    color: #fff;
  }
  .obs-updated {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--pale);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .obs-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pale);
    box-shadow: 0 0 0 0 rgba(169, 202, 236, 0.7);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from { box-shadow: 0 0 0 0 rgba(169, 202, 236, 0.7); }
    to { box-shadow: 0 0 0 12px rgba(169, 202, 236, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .obs-pulse { animation: none; }
  }
  .obs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem 1.8rem;
    margin-top: 1.5rem;
  }
  .obs-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-top: 1.5rem;
    max-width: 70ch;
  }
  @media (max-width: 880px) {
    .obs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .obs-grid {
      grid-template-columns: 1fr;
    }
  }

  .chapter-resources .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .resource-card {
    padding: 1.2rem;
  }
  .resource-card h4 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pale);
  }
  .resource-card p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
  .resource-links {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .resource-links a {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration-color: rgba(111, 165, 220, 0.4);
  }
  .resource-links a:hover {
    color: var(--pale);
  }
  @media (max-width: 880px) {
    .chapter-resources .resource-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
