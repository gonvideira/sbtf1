---
// ALTERNATIVE A — "ATLÂNTICO"
// Creative thesis: the quiet confidence of a centuries-old institution.
// Warm paper, deep navy ink, Algarve-gold accents; serif display typography;
// the rhythm of a beautifully typeset annual report. Motion is restrained:
// slow reveals, a breathing hero image — nothing that would feel out of place
// in print. Density is editorial: long-form thesis, plated photography,
// a term sheet that reads like a prospectus.
import '@fontsource-variable/fraunces'
import '@fontsource-variable/newsreader'
import '@fontsource-variable/inter'
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/a/${locale}/`
const altPath = `/a/${locale === 'pt' ? 'en' : 'pt'}/`

const isPt = locale === 'pt'
const chartTableLabel = isPt ? 'Ver dados' : 'View data'
const chartYearLabel = isPt ? 'Ano' : 'Year'
const chartValueLabel = isPt ? 'Auto-suficiência' : 'Self-sufficiency'
const heroCaption = isPt
  ? 'Instalações NaturaFish, estuário do Alvor e Arade — Algarve, Portugal.'
  : 'NaturaFish facilities, Alvor and Arade estuaries — Algarve, Portugal.'
const partnersTitle = isPt ? 'Ecossistema & Parceiros' : 'Ecosystem & Partners'
const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#FBF8F2"
  bodyClass="alt-a"
>
  <Fragment slot="head">
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image src={brand.logoNavy} alt="STAG | btf. — blue transformation fund" width={190} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={isPt ? 'Navegação principal' : 'Main navigation'}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ 1 · HERO ============ -->
    <section class="hero" id="hero">
      <div class="shell">
        <p class="kicker reveal">{t.hero.kicker}</p>
        <h1 class="hero-headline reveal">
          <span class="hl-1">{t.hero.headlineLine1}</span>
          <span class="hl-2">{t.hero.headlineLine2}</span>
        </h1>
        <p class="hero-sub reveal">{t.hero.subheadline}</p>
        <div class="hero-ctas reveal">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
          <a class="btn btn-text" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="hero-plate shell reveal">
        <div class="hero-plate-frame">
          <Picture
            src={photos.naturafishWide}
            alt={t.hero.imageAlt}
            widths={[640, 960, 1440, 1920]}
            sizes="(max-width: 1200px) 100vw, 1160px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>{heroCaption}</figcaption>
      </figure>

      <!-- stat band -->
      <div class="shell">
        <dl class="stat-band reveal">
          {t.statBar.stats.map((s) => (
            <div class="stat">
              <dd>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="footnote">{t.statBar.irrCaveat}</p>
      </div>
    </section>

    <!-- ============ 2 · BLUE OCEAN HUB ============ -->
    <section class="hub" id="hub" aria-labelledby="hub-title">
      <div class="shell">
        <div class="section-mark reveal"><span class="section-no">01</span><span class="section-rule"></span><span class="section-label">{t.hub.sectionLabel}</span></div>
        <div class="hub-head reveal">
          <h2 id="hub-title" class="display">{t.hub.title}</h2>
          <p class="lede">{t.hub.intro}</p>
        </div>

        <h3 class="sub-label reveal">{t.hub.statCardsTitle}</h3>
        <div class="hub-grid reveal">
          {t.hub.statCards.map((s) => (
            <article class="hub-card">
              <p class="hub-value">{s.value}</p>
              <p class="hub-label">{s.label}</p>
              <p class="hub-source">
                {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                {s.asOf && <span> · {s.asOf}</span>}
              </p>
            </article>
          ))}
        </div>

        <div class="hub-chart reveal">
          <div class="hub-chart-text">
            <h3 class="chart-title">{t.hub.chart.title}</h3>
            <p class="chart-sub">{t.hub.chart.subtitle}</p>
          </div>
          <LineChart
            data={euSelfSufficiency}
            locale={locale}
            yMin={30}
            yMax={50}
            yUnit="%"
            summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
            tableLabel={chartTableLabel}
            yearLabel={chartYearLabel}
            valueLabel={chartValueLabel}
          >
            <span slot="caption">{t.hub.chart.sourceNote}</span>
          </LineChart>
        </div>

        <!-- Research slot (swappable module fed by /research) -->
        <aside class="observatory reveal" aria-labelledby="obs-title" data-research-slot>
          <div class="obs-head">
            <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
            <p class="obs-updated"><span class="obs-pulse" aria-hidden="true"></span>{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
          </div>
          <div class="obs-grid">
            {research.map((s) => (
              <article class="obs-card">
                <p class="obs-value">{s.value}</p>
                <p class="obs-label">{s.label}</p>
                <p class="obs-source"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
              </article>
            ))}
          </div>
          <p class="obs-note">{t.hub.researchSlot.note}</p>
        </aside>

        <h3 class="sub-label reveal">{t.hub.resourcesTitle}</h3>
        <div class="resource-grid reveal">
          {t.hub.resourceCards.map((c) => (
            <article class="resource-card">
              <h4>{c.title}</h4>
              <p>{c.description}</p>
              <ul class="resource-links">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {l.label} {l.external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 3 · THE FUND ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <div class="shell">
        <div class="section-mark reveal"><span class="section-no">02</span><span class="section-rule"></span><span class="section-label">{t.fund.sectionLabel}</span></div>
      </div>

      <nav class="fund-subnav" aria-label={isPt ? 'Secções do fundo' : 'Fund sections'}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s) => (
              <li><a href={s.anchor}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <h2 id="thesis-title" class="display reveal">{t.fund.thesis.title}</h2>
          <div class="thesis-body reveal">
            <p class="drop-cap">{t.fund.thesis.paragraphs[0]}</p>
            <p>{t.fund.thesis.paragraphs[1]}</p>
            <p>{t.fund.thesis.paragraphs[2]}</p>
          </div>
          <div class="equation reveal" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
            {t.fund.thesis.equation.blocks.map((b, i) => (
              <>
                <span class="eq-block">{b}</span>
                <span class="eq-op" aria-hidden="true">{i < 2 ? '+' : '='}</span>
              </>
            ))}
            <span class="eq-result">{t.fund.thesis.equation.result}</span>
          </div>

          <div class="eu-context reveal">
            <h3 class="eu-title">{t.fund.euContext.title}</h3>
            <p class="eu-intro">{t.fund.euContext.intro}</p>
            <div class="eu-grid">
              {t.fund.euContext.stats.map((s) => (
                <div class="eu-stat">
                  <p class="eu-value">{s.value}</p>
                  <p class="eu-label">{s.label}</p>
                  <p class="eu-source">{s.source}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Verticals -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <h2 id="verticals-title" class="display reveal">{t.fund.verticals.title}</h2>
          <p class="lede reveal">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap reveal">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="vertical-list">
            {t.fund.verticals.items.map((v) => (
              <section class="vertical reveal" aria-labelledby={`v-${v.number}`}>
                <div class="v-head">
                  <span class="v-no">{v.number}</span>
                  <div>
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-alloc">{v.allocationLabel}</p>
                  </div>
                </div>
                <p class="v-copy">{v.copy}</p>
                <ul class="v-bullets">
                  {v.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title">
        <div class="shell">
          <h2 id="portfolio-title" class="display reveal">{t.fund.portfolio.title}</h2>
          <div class="portfolio-grid reveal">
            <figure class="portfolio-plate">
              <Picture
                src={photos.naturafishSquare}
                alt={t.fund.portfolio.imageAlt}
                widths={[480, 720, 1024]}
                sizes="(max-width: 900px) 100vw, 520px"
                formats={['avif', 'webp']}
                loading="lazy"
              />
              <figcaption>{heroCaption}</figcaption>
            </figure>
            <div class="portfolio-body">
              <p class="anchor-tag">{t.fund.portfolio.anchorTag}</p>
              <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
              <p class="anchor-copy">{t.fund.portfolio.copy}</p>
              <div class="farm-cards">
                {t.fund.portfolio.farms.map((f) => (
                  <div class="farm-card">
                    <p class="farm-name">{f.name}</p>
                    <p class="farm-specs">{f.specs}</p>
                  </div>
                ))}
              </div>
              <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Structure & Terms -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <h2 id="terms-title" class="display reveal">{t.fund.terms.title}</h2>
          <dl class="terms-table reveal">
            {t.fund.terms.rows.map((r) => (
              <div class="terms-row">
                <dt>{r.label}</dt>
                <dd>
                  <span class="terms-value">{r.value}</span>
                  {r.caveat && <span class="terms-caveat">{r.caveat}</span>}
                </dd>
              </div>
            ))}
          </dl>
          <p class="manager-line reveal">{t.fund.terms.managerLine}</p>
          <p class="footnote reveal">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <h2 id="team-title" class="display reveal">{t.fund.team.title}</h2>
          {t.fund.team.groups.map((g) => (
            <section class="team-group reveal" aria-label={g.title}>
              <h3 class="sub-label">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member">
                    {m.photo && teamPhotos[m.photo] ? (
                      <Image
                        class="member-photo"
                        src={teamPhotos[m.photo]!}
                        alt={m.name}
                        width={400}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    ) : (
                      <div class="member-monogram" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span aria-hidden="true">{m.name.split(' ').map((w) => w[0]).filter((_, i, a) => i === 0 || i === a.length - 1).join('')}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <h2 id="process-title" class="display reveal">{t.fund.process.title}</h2>
          <p class="lede reveal">{t.fund.process.intro}</p>
          <ol class="steps reveal">
            {t.fund.process.steps.map((s, i) => (
              <li class="step">
                <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.description}</p>
              </li>
            ))}
          </ol>
          <div class="invest-cta reveal">
            <div class="contact-card">
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role">{t.fund.process.contact.role}</p>
              <p class="contact-line"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line contact-general"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-solid" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary} <span aria-hidden="true">→</span></a>
              <a class="btn btn-outline" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary} <span aria-hidden="true">→</span></a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={partnersTitle}>
      <div class="shell">
        <h2 class="sub-label reveal">{partnersTitle}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={44} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={210} densities={[1, 2]} loading="lazy" />
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <nav class="footer-links" aria-label={isPt ? 'Links legais' : 'Legal links'}>
        <ul>
          {t.footer.links.map((l) => (
            <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens ===== */
  :global(body.alt-a) {
    --paper: #fbf8f2;
    --paper-deep: #f3eee3;
    --ink: #16233b;
    --ink-soft: #44536b;
    --ink-muted: #5b6b80;
    --navy: #0d3b6e;
    --blue: #1a5b9a;
    --amber: #c4830a;
    --amber-text: #8a5a04;
    --hairline: #e0d8c8;
    --font-display: 'Fraunces Variable', Georgia, serif;
    --font-body: 'Newsreader Variable', Georgia, serif;
    --font-ui: 'Inter Variable', system-ui, sans-serif;

    --chart-line: #1a5b9a;
    --chart-c1: #1a5b9a;
    --chart-c2: #008e9c;
    --chart-c3: #a96f06;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: #e6dfd1;
    --chart-surface: var(--paper);
    --chart-deemph: #97a4b5;
    --chart-font: var(--font-ui);

    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
  }

  .shell {
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  /* ===== Type utilities ===== */
  .kicker {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--amber-text);
  }
  .display {
    font-family: var(--font-display);
    font-weight: 560;
    font-variation-settings: 'SOFT' 40, 'WONK' 0;
    line-height: 1.06;
    letter-spacing: -0.01em;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    max-width: 21ch;
  }
  .lede {
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 62ch;
    margin-top: 1.1rem;
  }
  .sub-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 3rem 0 1.2rem;
  }
  .footnote {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-muted);
    max-width: 70ch;
    margin-top: 0.9rem;
  }
  .section-mark {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(3.5rem, 8vw, 6rem);
    margin-bottom: 1.6rem;
    font-family: var(--font-ui);
  }
  .section-no {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--amber-text);
  }
  .section-rule {
    flex: 0 0 64px;
    height: 1px;
    background: var(--hairline);
  }
  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 3px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .btn-solid {
    background: var(--navy);
    color: #fff;
    padding: 0.85rem 1.5rem;
  }
  .btn-solid:hover {
    background: var(--blue);
  }
  .btn-outline {
    border: 1px solid var(--navy);
    color: var(--navy);
    padding: 0.8rem 1.5rem;
  }
  .btn-outline:hover {
    background: var(--navy);
    color: #fff;
  }
  .btn-text {
    color: var(--navy);
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--hairline);
    border-radius: 0;
  }
  .btn-text:hover {
    border-color: var(--amber);
    color: var(--amber-text);
  }

  /* ===== Header ===== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }
  .logo-link img {
    width: clamp(140px, 16vw, 190px);
    height: auto;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.7rem);
    list-style: none;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav-list a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .nav-list a:hover {
    color: var(--navy);
  }
  .nav-lang a {
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--amber-text);
  }
  .nav-cta {
    background: var(--navy);
    color: #fff !important;
    padding: 0.55rem 1.05rem;
    border-radius: 3px;
  }
  .nav-cta:hover {
    background: var(--blue);
  }
  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink);
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-toggle-bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease;
  }
  @media (max-width: 880px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--hairline);
      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid var(--hairline);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero ===== */
  .hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }
  .hero-headline {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 560;
    font-variation-settings: 'SOFT' 40, 'WONK' 0;
    font-size: clamp(2.1rem, 5.4vw, 4.05rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  .hero-headline .hl-1,
  .hero-headline .hl-2 {
    display: block;
  }
  .hero-headline .hl-2 {
    font-style: italic;
    font-weight: 480;
    color: var(--amber-text);
    margin-top: 0.15em;
  }
  .hero-sub {
    margin-top: 1.4rem;
    font-size: clamp(1.1rem, 1.8vw, 1.32rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    align-items: center;
    margin-top: 2rem;
  }
  .hero-plate {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .hero-plate-frame {
    border: 1px solid var(--hairline);
    padding: clamp(0.5rem, 1.4vw, 0.9rem);
    background: #fff;
  }
  .hero-plate-frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 1080;
    object-fit: cover;
  }
  .hero-plate figcaption {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin-top: 0.7rem;
    letter-spacing: 0.02em;
  }

  /* ===== Stat band ===== */
  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: clamp(2.6rem, 6vw, 4rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hairline);
    padding: 0;
  }
  .stat {
    padding: 1.4rem 1.2rem 1.4rem 0;
    border-right: 1px solid var(--hairline);
  }
  .stat:last-child {
    border-right: none;
  }
  .stat + .stat {
    padding-left: 1.2rem;
  }
  .stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    color: var(--navy);
    margin: 0;
  }
  .stat dt {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-top: 0.35rem;
    line-height: 1.4;
  }
  @media (max-width: 760px) {
    .stat-band {
      grid-template-columns: 1fr 1fr;
    }
    .stat {
      border-bottom: 1px solid var(--hairline);
      padding-left: 1rem;
    }
    .stat:nth-child(even) {
      border-right: none;
    }
    .stat:nth-child(3),
    .stat:nth-child(4) {
      border-bottom: none;
    }
  }

  /* ===== Hub ===== */
  .hub {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hub-head .lede {
    margin-top: 1rem;
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .hub-card {
    background: var(--paper);
    padding: 1.4rem 1.3rem 1.2rem;
  }
  .hub-value {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--navy);
  }
  .hub-label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .hub-source {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.7rem;
  }
  .hub-source a {
    color: inherit;
    text-decoration-color: var(--hairline);
  }
  .hub-source a:hover {
    color: var(--amber-text);
  }
  @media (max-width: 980px) {
    .hub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
  }

  .hub-chart {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 3rem;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--hairline);
    background: #fff;
  }
  .chart-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .chart-sub {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-top: 0.6rem;
  }
  .hub-chart :global(.lc-wrap),
  .hub-chart :global(figure) {
    --chart-surface: #fff;
  }
  @media (max-width: 820px) {
    .hub-chart {
      grid-template-columns: 1fr;
    }
  }

  /* Observatory / research slot */
  .observatory {
    margin-top: 3rem;
    border: 1px solid var(--navy);
    background: var(--paper-deep);
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }
  .obs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .obs-head h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .obs-updated {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--amber-text);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .obs-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
  }
  .obs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem 2rem;
    margin-top: 1.6rem;
  }
  .obs-value {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--navy);
  }
  .obs-label {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.3rem;
  }
  .obs-source {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.45rem;
  }
  .obs-source a {
    color: inherit;
    text-decoration-color: var(--hairline);
  }
  .obs-note {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-top: 1.6rem;
    max-width: 70ch;
  }
  @media (max-width: 880px) {
    .obs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .obs-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Resource cards */
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
  }
  .resource-card {
    border-top: 2px solid var(--navy);
    padding-top: 1rem;
  }
  .resource-card h4 {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .resource-card p {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
  .resource-links {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .resource-links a {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--blue);
    text-decoration-color: var(--hairline);
  }
  .resource-links a:hover {
    color: var(--amber-text);
  }
  @media (max-width: 880px) {
    .resource-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== Fund macro ===== */
  .fund {
    background: linear-gradient(var(--paper), var(--paper-deep) 12%, var(--paper-deep) 88%, var(--paper));
  }
  .fund-subnav {
    position: sticky;
    top: 57px;
    z-index: 40;
    background: color-mix(in srgb, var(--paper-deep) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block: 1px solid var(--hairline);
  }
  .fund-subnav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.2rem);
    list-style: none;
    padding: 0.7rem 0;
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .fund-subnav a {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .fund-subnav a:hover {
    color: var(--navy);
  }

  .thesis,
  .verticals,
  .portfolio,
  .terms,
  .team,
  .process {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    scroll-margin-top: 110px;
  }

  .thesis-body {
    columns: 2;
    column-gap: 3rem;
    margin-top: 2rem;
    max-width: 66rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .thesis-body p {
    break-inside: avoid;
    margin-bottom: 1.2rem;
  }
  .drop-cap::first-letter {
    font-family: var(--font-display);
    font-size: 3.4em;
    font-weight: 600;
    float: left;
    line-height: 0.82;
    padding-right: 0.12em;
    color: var(--navy);
  }
  @media (max-width: 820px) {
    .thesis-body {
      columns: 1;
    }
  }

  .equation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.6rem;
  }
  .eq-block {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--hairline);
    background: #fff;
    padding: 0.85rem 1.2rem;
    border-radius: 3px;
  }
  .eq-op {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--amber-text);
  }
  .eq-result {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 700;
    background: var(--navy);
    color: #fff;
    padding: 0.9rem 1.3rem;
    border-radius: 3px;
  }

  .eu-context {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--hairline);
    padding-top: 2.4rem;
  }
  .eu-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 600;
    max-width: 28ch;
  }
  .eu-intro {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.65;
  }
  .eu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    margin-top: 2rem;
  }
  .eu-value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 600;
    color: var(--amber-text);
  }
  .eu-label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .eu-source {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.5rem;
  }
  @media (max-width: 820px) {
    .eu-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Verticals */
  .alloc-wrap {
    margin-top: 2.2rem;
    max-width: 46rem;
  }
  .vertical-list {
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    display: flex;
    flex-direction: column;
  }
  .vertical {
    border-top: 1px solid var(--hairline);
    padding: 2.2rem 0;
    display: grid;
    grid-template-columns: minmax(240px, 1.1fr) 1.6fr 1.4fr;
    gap: clamp(1.4rem, 3vw, 2.6rem);
  }
  .v-head {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .v-no {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--amber-text);
  }
  .v-head h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .v-alloc {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-top: 0.45rem;
  }
  .v-copy {
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .v-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.87rem;
    color: var(--ink-soft);
  }
  .v-bullets li {
    padding-left: 1.1rem;
    position: relative;
    line-height: 1.45;
  }
  .v-bullets li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--amber);
    font-weight: 700;
    font-size: 1.3em;
    line-height: 1;
  }
  @media (max-width: 880px) {
    .vertical {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Portfolio */
  .portfolio-grid {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) 1.3fr;
    gap: clamp(1.8rem, 4vw, 3.2rem);
    margin-top: 2.2rem;
    align-items: start;
  }
  .portfolio-plate {
    border: 1px solid var(--hairline);
    background: #fff;
    padding: clamp(0.5rem, 1.2vw, 0.8rem);
    margin: 0;
  }
  .portfolio-plate img {
    width: 100%;
    height: auto;
  }
  .portfolio-plate figcaption {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.6rem;
  }
  .anchor-tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber-text);
  }
  .anchor-name {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .anchor-copy {
    margin-top: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .farm-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.6rem;
    max-width: 34rem;
  }
  .farm-card {
    border: 1px solid var(--hairline);
    background: #fff;
    padding: 1rem 1.1rem;
  }
  .farm-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--navy);
  }
  .farm-specs {
    font-family: var(--font-ui);
    font-size: 0.83rem;
    color: var(--ink-muted);
    margin-top: 0.3rem;
  }
  .pipeline-note {
    font-style: italic;
    color: var(--ink-soft);
    margin-top: 1.6rem;
    max-width: 58ch;
    line-height: 1.6;
    border-left: 2px solid var(--amber);
    padding-left: 1rem;
  }
  @media (max-width: 880px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Terms */
  .terms-table {
    margin-top: 2rem;
    border-top: 1px solid var(--ink);
    max-width: 46rem;
  }
  .terms-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .terms-row dt {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .terms-row dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .terms-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--navy);
  }
  .terms-caveat {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .manager-line {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-top: 1.6rem;
    max-width: 60ch;
  }

  /* Team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: clamp(1.4rem, 3vw, 2.2rem);
  }
  .member-photo,
  .member-monogram {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--hairline);
    filter: saturate(0.85);
  }
  .member-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 500;
  }
  .member-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 0.9rem;
  }
  .member-name a {
    color: inherit;
    text-decoration-color: var(--hairline);
  }
  .member-name a:hover {
    color: var(--blue);
  }
  .member-role {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-text);
    margin-top: 0.25rem;
  }
  .member-bio {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  /* Process */
  .steps {
    list-style: none;
    padding: 0;
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
    counter-reset: step;
  }
  .step {
    border-top: 2px solid var(--navy);
    padding-top: 1rem;
  }
  .step-no {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--amber-text);
  }
  .step-title {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.4rem;
  }
  .step-desc {
    font-family: var(--font-ui);
