    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.45rem;
  }
  @media (max-width: 980px) {
    .steps {
      grid-template-columns: 1fr;
      max-width: 34rem;
    }
    .step {
      display: grid;
      grid-template-columns: 3rem 1fr;
      grid-template-rows: auto auto;
