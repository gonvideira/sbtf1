---
// ALTERNATIVE C — "CORRENTE"
// Creative thesis: a current of data. Kinetic editorial energy — the vortex
// hero cuts to a running ticker of sector figures; the Hub is a dark dive
// chaptered by oversized numerals; the Fund tells "back to the future" as a
// film-title sequence: 1500 → HOJE → 2034 in monumental monospace dates,
// followed by an institutional dossier (value-chain schematic, spec-sheet
// portfolio). Light and dark alternate like surfacing between dives. The
// most typographically aggressive of the three — all of it in logo blue.
import '@fontsource-variable/ibm-plex-sans'
import '@fontsource-variable/jetbrains-mono'
import plexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url'
import jbMonoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import RangeBars from '@/components/charts/RangeBars.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fcrComparison, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/c/${locale}/`
const altPath = `/c/${locale === 'pt' ? 'en' : 'pt'}/`
const isPt = locale === 'pt'

const L = isPt
  ? {
      chartTable: 'Ver dados',
      chartYear: 'Ano',
      chartValue: 'Auto-suficiência',
      cue: 'Explorar',
      tickerLabel: 'Indicadores do sector',
      diveKicker: 'O mergulho',
      eras: ['1500', 'HOJE', '2034'] as const,
      eraLabels: ['O know-how', 'A oportunidade', 'O veículo'] as const,
      eraKicker: 'Regressar ao futuro',
      fcrTitle: 'Eficiência proteica — FCR',
      fcrSub: 'kg de ração por kg de proteína produzida',
      fcrNote: 'Fonte: FAO / BlueInvest — intervalos típicos',
      fcrSummary:
        'Rácio de conversão alimentar por proteína: aquacultura 1,2–1,5; frango 1,7–2,0; suíno 2,7–5,0; bovino 6–10.',
      fcrRows: ['Aquacultura', 'Frango', 'Suíno', 'Bovino'] as const,
      farmParams: [
        ['Localização', 'Estuário do Alvor', 'Estuário do Arade'],
        ['Área', '19 ha', '21 ha'],
        ['Tanques', '19', '22'],
        ['Capacidade', '~550 t/ano', '~650 t/ano'],
        ['Espécies', 'Robalo · Dourada', 'Robalo · Dourada'],
      ] as const,
      farmSheetCaption: 'Ficha técnica das quintas NaturaFish',
      param: 'Parâmetro',
      partners: 'Ecossistema & Parceiros',
      metrics: 'Métricas do fundo',
      videoPlay: 'Reproduzir vídeo de fundo',
      videoPause: 'Pausar vídeo de fundo',
      navLabel: 'Navegação principal',
      fundNav: 'Secções do fundo',
      legalNav: 'Links legais',
      photoPending: 'FOTO PENDENTE',
    }
  : {
      chartTable: 'View data',
      chartYear: 'Year',
      chartValue: 'Self-sufficiency',
      cue: 'Explore',
      tickerLabel: 'Sector indicators',
      diveKicker: 'The dive',
      eras: ['1500', 'TODAY', '2034'] as const,
      eraLabels: ['The know-how', 'The opportunity', 'The vehicle'] as const,
      eraKicker: 'Back to the future',
      fcrTitle: 'Protein efficiency — FCR',
      fcrSub: 'kg of feed per kg of protein produced',
      fcrNote: 'Source: FAO / BlueInvest — typical ranges',
      fcrSummary:
        'Feed conversion ratio by protein: aquaculture 1.2–1.5; chicken 1.7–2.0; pork 2.7–5.0; beef 6–10.',
      fcrRows: ['Aquaculture', 'Chicken', 'Pork', 'Beef'] as const,
      farmParams: [
        ['Location', 'Alvor estuary', 'Arade estuary'],
        ['Area', '19 ha', '21 ha'],
        ['Ponds', '19', '22'],
        ['Capacity', '~550 t/yr', '~650 t/yr'],
        ['Species', 'Seabass · Seabream', 'Seabass · Seabream'],
      ] as const,
      farmSheetCaption: 'NaturaFish farm specification sheet',
      param: 'Parameter',
      partners: 'Ecosystem & Partners',
      metrics: 'Fund metrics',
      videoPlay: 'Play background video',
      videoPause: 'Pause background video',
      navLabel: 'Main navigation',
      fundNav: 'Fund sections',
      legalNav: 'Legal links',
      photoPending: 'PHOTO PENDING',
    }

const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))

const fcrRows = L.fcrRows.map((label, i) => ({
  label,
  min: fcrComparison[i]!.min,
  max: fcrComparison[i]!.max,
  highlight: i === 0,
}))

// ticker: the hub stat cards, doubled for a seamless loop
const tickerStats = t.hub.statCards.map((s) => ({ value: s.value, label: s.label, source: s.source }))
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#F2F7FC"
  bodyClass="alt-c"
>
  <Fragment slot="head">
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbMonoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/media/fish-vortex-poster.jpg" as="image" />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={175} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={L.navLabel}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" id="hero" data-scene>
      <div class="hero-media">
        <video
          data-ambient
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/media/fish-vortex-poster.jpg"
          width="1600"
          height="898"
          aria-hidden="true"
        >
          <source src="/media/fish-vortex.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source src="/media/fish-vortex.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="hero-veil" aria-hidden="true"></div>
      </div>
      <div class="shell hero-content">
        <p class="kicker rise" style="--d:0ms"><span class="tick" aria-hidden="true"></span>{t.hero.kicker}</p>
        <h1 class="hero-headline">
          <span class="hl-clip"><span class="hl-1 slide" style="--d:150ms">{t.hero.headlineLine1}</span></span>
          <span class="hl-clip"><span class="hl-2 slide" style="--d:400ms">{t.hero.headlineLine2}</span></span>
        </h1>
        <p class="hero-sub rise" style="--d:650ms">{t.hero.subheadline}</p>
        <div class="hero-ctas rise" style="--d:800ms">
          <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <a class="scroll-cue" href="#stats" aria-label={L.cue}>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <!-- ticker + stat readout -->
    <section class="stats" id="stats" aria-label={L.metrics}>
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {[0, 1].map(() => (
            <div class="ticker-run">
              {tickerStats.map((s) => (
                <span class="ticker-item mono"><b>{s.value}</b> {s.label} <i>· {s.source}</i></span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="shell">
        <dl class="stat-band">
          {t.statBar.stats.map((s, i) => (
            <div class="stat reveal">
              <dt class="mono">{`M0${i + 1}`} — {s.label}</dt>
              <dd class="mono" data-count>{s.value}</dd>
            </div>
          ))}
        </dl>
        <p class="footnote">{t.statBar.irrCaveat}</p>
      </div>
    </section>

    <!-- ============ HUB — the dive in numbered chapters ============ -->
    <section class="dive" id="hub" aria-labelledby="hub-title" data-scrub>
      <div class="dive-media" aria-hidden="true">
        <video
          data-ambient
          muted
          loop
          playsinline
          preload="none"
          poster="/media/dolphin-deep-poster.jpg"
          width="1600"
          height="900"
        >
          <source src="/media/dolphin-deep.av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
          <source src="/media/dolphin-deep.mp4" type="video/mp4" />
        </video>
        <button
          class="video-toggle"
          data-video-toggle
          data-label-play={L.videoPlay}
          data-label-pause={L.videoPause}
          aria-label={L.videoPause}
        >
          <span class="vt-pause" aria-hidden="true"></span>
          <span class="vt-play" aria-hidden="true"></span>
        </button>
        <div class="dive-veil"></div>
      </div>

      <div class="dive-chapters">
        <div class="chapter" data-scene>
          <svg class="chapter-no" aria-hidden="true" data-parallax="0.14" viewBox="0 0 200 150"><text x="100" y="118" text-anchor="middle">01</text></svg>
          <div class="shell">
            <div class="panel panel-intro" data-parallax="0.05">
              <p class="chapter-kicker mono">{L.diveKicker} — 01</p>
              <h2 id="hub-title" class="dive-display">{t.hub.title}</h2>
              <p class="dive-lede">{t.hub.intro}</p>
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <svg class="chapter-no" aria-hidden="true" data-parallax="0.14" viewBox="0 0 200 150"><text x="100" y="118" text-anchor="middle">02</text></svg>
          <div class="shell">
            <h3 class="chapter-label mono" data-parallax="0.04">{t.hub.statCardsTitle}</h3>
            <div class="panel-grid">
              {t.hub.statCards.map((s, i) => (
                <article class="panel panel-stat" data-parallax={String(0.02 + (i % 4) * 0.02)}>
                  <p class="p-idx mono">D{String(i + 1).padStart(2, '0')}</p>
                  <p class="p-value mono" data-count>{s.value}</p>
                  <p class="p-label">{s.label}</p>
                  <p class="p-source mono">
                    {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                    {s.asOf && <span> · {s.asOf}</span>}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <svg class="chapter-no" aria-hidden="true" data-parallax="0.14" viewBox="0 0 200 150"><text x="100" y="118" text-anchor="middle">03</text></svg>
          <div class="shell chapter-figs">
            <div class="panel panel-chart" data-parallax="0.05">
              <h3 class="p-title">{t.hub.chart.title}</h3>
              <p class="p-sub">{t.hub.chart.subtitle}</p>
              <LineChart
                data={euSelfSufficiency}
                locale={locale}
                yMin={30}
                yMax={50}
                yUnit="%"
                summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
                tableLabel={L.chartTable}
                yearLabel={L.chartYear}
                valueLabel={L.chartValue}
              >
                <span slot="caption">{t.hub.chart.sourceNote}</span>
              </LineChart>
            </div>
            <div class="panel panel-chart panel-chart-sm" data-parallax="0.09">
              <h3 class="p-title">{L.fcrTitle}</h3>
              <p class="p-sub">{L.fcrSub}</p>
              <RangeBars rows={fcrRows} locale={locale} xMax={10} summary={L.fcrSummary} unitNote={L.fcrNote} />
            </div>
          </div>
        </div>

        <div class="chapter" data-scene>
          <svg class="chapter-no" aria-hidden="true" data-parallax="0.14" viewBox="0 0 200 150"><text x="100" y="118" text-anchor="middle">04</text></svg>
          <div class="shell">
            <aside class="panel panel-obs" aria-labelledby="obs-title" data-research-slot data-parallax="0.05">
              <div class="obs-head">
                <h3 id="obs-title">{t.hub.researchSlot.title}</h3>
                <p class="obs-updated mono">{t.hub.researchSlot.updatedLabel} {researchUpdated}</p>
              </div>
              <div class="obs-grid">
                {research.map((s, i) => (
                  <article class="obs-card">
                    <p class="p-idx mono">R{String(i + 1).padStart(2, '0')}</p>
                    <p class="p-value p-value-sm mono">{s.value}</p>
                    <p class="p-label">{s.label}</p>
                    <p class="p-source mono"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
                  </article>
                ))}
              </div>
              <p class="obs-note">{t.hub.researchSlot.note}</p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- resources — resurfaced, light -->
    <section class="resources" aria-label={t.hub.resourcesTitle}>
      <div class="shell">
        <h2 class="display reveal">{t.hub.resourcesTitle}</h2>
        <div class="resource-grid">
          {t.hub.resourceCards.map((c, i) => (
            <article class="resource-card reveal">
              <p class="p-idx mono">L{String(i + 1).padStart(2, '0')}</p>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              <ul class="resource-links">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {l.label} {l.external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE FUND — a film-title sequence ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <nav class="fund-subnav" aria-label={L.fundNav}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s, i) => (
              <li><a href={s.anchor}><span class="mono subnav-idx">{String(i + 1).padStart(2, '0')}</span>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis: 1500 → HOJE → 2034 -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <p class="kicker kicker-dark reveal"><span class="tick" aria-hidden="true"></span>{L.eraKicker}</p>
          <h2 id="thesis-title" class="display reveal">{t.fund.thesis.title}</h2>
          <div class="era-cards">
            {t.fund.thesis.paragraphs.map((p, i) => (
              <div class="era-card reveal" data-scene>
                <p class="era-date mono" data-parallax="0.05">{L.eras[i]}</p>
                <p class="era-role mono">{L.eraLabels[i]}</p>
                <p class="era-copy">{p}</p>
              </div>
            ))}
          </div>
          <div class="equation reveal" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
            {t.fund.thesis.equation.blocks.map((b, i) => (
              <>
                <span class="eq-block">{b}</span>
                <span class="eq-op mono" aria-hidden="true">{i < 2 ? '+' : '='}</span>
              </>
            ))}
            <span class="eq-result">{t.fund.thesis.equation.result}</span>
          </div>

          <div class="eu-context reveal">
            <h3 class="eu-title">{t.fund.euContext.title}</h3>
            <p class="eu-intro">{t.fund.euContext.intro}</p>
            <div class="eu-grid">
              {t.fund.euContext.stats.map((s) => (
                <div class="eu-stat">
                  <p class="eu-value mono" data-count>{s.value}</p>
                  <p class="eu-label">{s.label}</p>
                  <p class="eu-source mono">{s.source}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Verticals — value chain -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <h2 id="verticals-title" class="display reveal">{t.fund.verticals.title}</h2>
          <p class="lede reveal">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap reveal">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="chain" role="list">
            {t.fund.verticals.items.map((v, i) => (
              <>
                <section class="chain-node reveal" role="listitem" aria-labelledby={`v-${v.number}`}>
                  <div class="node-bar mono">
                    <span>V{v.number}</span>
                    <span>{v.allocationLabel}</span>
                  </div>
                  <div class="node-body">
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-copy">{v.copy}</p>
                    <ul class="v-bullets">
                      {v.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                </section>
                {i < 2 && <span class="chain-arrow mono" aria-hidden="true">→</span>}
              </>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title" data-scene>
        <div class="shell">
          <h2 id="portfolio-title" class="display reveal">{t.fund.portfolio.title}</h2>
          <div class="portfolio-grid">
            <div class="portfolio-body reveal">
              <p class="anchor-tag mono">{t.fund.portfolio.anchorTag}</p>
              <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
              <p class="anchor-copy">{t.fund.portfolio.copy}</p>
              <table class="farm-sheet">
                <caption class="sr-only">{L.farmSheetCaption}</caption>
                <thead>
                  <tr>
                    <th scope="col" class="mono">{L.param}</th>
                    <th scope="col" class="mono">Alvor</th>
                    <th scope="col" class="mono">Arade</th>
                  </tr>
                </thead>
                <tbody>
                  {L.farmParams.map((row) => (
                    <tr>
                      <th scope="row">{row[0]}</th>
                      <td class="mono">{row[1]}</td>
                      <td class="mono">{row[2]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
            </div>
            <figure class="portfolio-plate reveal">
              <div class="plate-inner" data-parallax="0.1">
                <Picture
                  src={photos.naturafishSquare}
                  alt={t.fund.portfolio.imageAlt}
                  widths={[480, 720, 1024]}
                  sizes="(max-width: 980px) 100vw, 480px"
                  formats={['avif', 'webp']}
                  loading="lazy"
                />
              </div>
              <figcaption class="mono">NaturaFish · Alvor + Arade · Algarve</figcaption>
            </figure>
          </div>
        </div>
      </article>

      <!-- Structure & Terms — number wall -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <h2 id="terms-title" class="display display-light reveal">{t.fund.terms.title}</h2>
          <div class="terms-grid">
            {t.fund.terms.rows.map((r, i) => (
              <div class="terms-card reveal">
                <p class="terms-label mono">T{String(i + 1).padStart(2, '0')} — {r.label}</p>
                <p class="terms-value mono" data-count>{r.value}</p>
                {r.caveat && <p class="terms-caveat">{r.caveat}</p>}
              </div>
            ))}
          </div>
          <p class="manager-line reveal">{t.fund.terms.managerLine}</p>
          <p class="footnote footnote-light reveal">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <h2 id="team-title" class="display reveal">{t.fund.team.title}</h2>
          {t.fund.team.groups.map((g) => (
            <section class="team-group" aria-label={g.title}>
              <h3 class="sub-label mono reveal">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member reveal">
                    {m.photo && teamPhotos[m.photo] ? (
                      <Image
                        class="member-photo"
                        src={teamPhotos[m.photo]!}
                        alt={m.name}
                        width={400}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    ) : (
                      <div class="member-pending" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span class="mono" aria-hidden="true">{L.photoPending}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role mono">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <h2 id="process-title" class="display reveal">{t.fund.process.title}</h2>
          <p class="lede reveal">{t.fund.process.intro}</p>
          <ol class="steps">
            {t.fund.process.steps.map((s, i) => (
              <li class="step reveal">
                <span class="step-no mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.description}</p>
              </li>
            ))}
          </ol>
          <div class="invest-cta reveal">
            <div class="contact-card">
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role mono">{t.fund.process.contact.role}</p>
              <p class="contact-line mono"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line mono"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line mono"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-navy" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary} <span aria-hidden="true">→</span></a>
              <a class="btn btn-outline" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary} <span aria-hidden="true">→</span></a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={L.partners}>
      <div class="shell">
        <h2 class="sub-label mono reveal">{L.partners}</h2>
        <ul class="partner-strip reveal">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={40} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={200} densities={[1, 2]} loading="lazy" />
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <nav class="footer-links" aria-label={L.legalNav}>
        <ul>
          {t.footer.links.map((l) => (
            <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright mono">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
