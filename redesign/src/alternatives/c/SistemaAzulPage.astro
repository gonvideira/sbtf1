---
// ALTERNATIVE C — "SISTEMA AZUL"
// Creative thesis: the fund as an engineered system. Ice-white surfaces on a
// visible structural grid; section codes and figure numbers like a technical
// dossier; monospace numerals for every quantity; the value chain drawn as a
// schematic. Amber is a marker pen — used only to flag what matters. Motion
// is precise and instantaneous: underline sweeps, corner ticks, nothing
// decorative. The register of an engineering firm that happens to manage
// €126M — highest information density of the three.
import '@fontsource-variable/archivo'
import '@fontsource-variable/jetbrains-mono'
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import jbMonoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import '@/styles/base.css'

import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineChart from '@/components/charts/LineChart.astro'
import RangeBars from '@/components/charts/RangeBars.astro'
import AllocationStripe from '@/components/charts/AllocationStripe.astro'
import { getContent, type Locale } from '@/content'
import { euSelfSufficiency, fcrComparison, fundAllocation } from '@/data/charts'
import { getResearchStats, researchUpdated } from '@/data/research'
import { brand, photos, teamPhotos, partners } from '@/data/images'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getContent(locale)
const research = getResearchStats(locale)

const path = `/c/${locale}/`
const altPath = `/c/${locale === 'pt' ? 'en' : 'pt'}/`

const isPt = locale === 'pt'
const chartTableLabel = isPt ? 'Ver dados' : 'View data'
const chartYearLabel = isPt ? 'Ano' : 'Year'
const chartValueLabel = isPt ? 'Auto-suficiência' : 'Self-sufficiency'
const heroCaption = isPt
  ? 'Instalações NaturaFish · estuário do Alvor e Arade · Algarve'
  : 'NaturaFish facilities · Alvor and Arade estuaries · Algarve'
const partnersTitle = isPt ? 'Ecossistema & Parceiros' : 'Ecosystem & Partners'
const mailSubjectCim = encodeURIComponent(isPt ? 'Pedido de acesso ao CIM — SBTF 1' : 'CIM access request — SBTF 1')
const mailSubjectMeet = encodeURIComponent(isPt ? 'Pedido de reunião — SBTF 1' : 'Meeting request — SBTF 1')

const fcrRows = [
  { label: isPt ? 'Aquacultura' : 'Aquaculture', min: fcrComparison[0]!.min, max: fcrComparison[0]!.max, highlight: true },
  { label: isPt ? 'Frango' : 'Chicken', min: fcrComparison[1]!.min, max: fcrComparison[1]!.max },
  { label: isPt ? 'Suíno' : 'Pork', min: fcrComparison[2]!.min, max: fcrComparison[2]!.max },
  { label: isPt ? 'Bovino' : 'Beef', min: fcrComparison[3]!.min, max: fcrComparison[3]!.max },
]

const allocSegments = t.fund.verticals.items.map((v, i) => ({
  label: v.title,
  pct: v.allocationPct,
  amount: fundAllocation[i]!.amount,
}))

const farmSheet = isPt
  ? [
      { param: 'Localização', alvor: 'Estuário do Alvor', arade: 'Estuário do Arade' },
      { param: 'Área', alvor: '19 ha', arade: '21 ha' },
      { param: 'Tanques', alvor: '19', arade: '22' },
      { param: 'Capacidade', alvor: '~550 t/ano', arade: '~650 t/ano' },
      { param: 'Espécies', alvor: 'Robalo · Dourada', arade: 'Robalo · Dourada' },
    ]
  : [
      { param: 'Location', alvor: 'Alvor estuary', arade: 'Arade estuary' },
      { param: 'Area', alvor: '19 ha', arade: '21 ha' },
      { param: 'Ponds', alvor: '19', arade: '22' },
      { param: 'Capacity', alvor: '~550 t/yr', arade: '~650 t/yr' },
      { param: 'Species', alvor: 'Seabass · Seabream', arade: 'Seabass · Seabream' },
    ]
---

<BaseLayout
  locale={locale}
  title={t.nav.pageTitle}
  description={t.nav.metaDescription}
  path={path}
  altPath={altPath}
  themeColor="#F4F8FB"
  bodyClass="alt-c"
>
  <Fragment slot="head">
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbMonoUrl} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="logo-link" href={path} aria-label="Blue Transformation Fund">
        <Image src={brand.logoNavy} alt="STAG | btf. — blue transformation fund" width={175} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label={isPt ? 'Navegação principal' : 'Main navigation'}>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <ul id="nav-list" class="nav-list">
          {t.nav.items.map((item) => (
            <li><a href={item.anchor}>{item.label}</a></li>
          ))}
          <li class="nav-lang">
            <a href={altPath} rel="alternate" hreflang={isPt ? 'en' : 'pt-PT'} aria-label={t.a11y.langSwitchLabel}>
              {isPt ? 'EN' : 'PT'}
            </a>
          </li>
          <li class="nav-cta-item">
            <a class="nav-cta" href={t.nav.cta.anchor}>{t.nav.cta.label} <span aria-hidden="true">→</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" id="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span class="tick" aria-hidden="true"></span>{t.hero.kicker}</p>
          <h1 class="hero-headline">
            <span class="hl-1">{t.hero.headlineLine1}</span>
            <span class="hl-2">{t.hero.headlineLine2}</span>
          </h1>
          <p class="hero-sub">{t.hero.subheadline}</p>
          <div class="hero-ctas">
            <a class="btn btn-solid" href={t.hero.ctaPrimary.anchor}>{t.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
            <a class="btn btn-outline" href={t.hero.ctaSecondary.anchor}>{t.hero.ctaSecondary.label} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="hero-module">
          <div class="module-bar">
            <span class="mono">FIG. 00</span>
            <span class="mono">37°08′N · 8°37′W</span>
          </div>
          <Picture
            src={photos.naturafishWide}
            alt={t.hero.imageAlt}
            widths={[640, 960, 1440]}
            sizes="(max-width: 980px) 100vw, 620px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="module-caption mono">{heroCaption}</figcaption>
        </figure>
      </div>

      <!-- stat readout -->
      <div class="stat-readout" role="group" aria-label={isPt ? 'Métricas do fundo' : 'Fund metrics'}>
        <div class="shell">
          <dl class="stat-band">
            {t.statBar.stats.map((s, i) => (
              <div class="stat">
                <dt class="mono">{`M0${i + 1}`} — {s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="footnote">{t.statBar.irrCaveat}</p>
        </div>
      </div>
    </section>

    <!-- ============ HUB ============ -->
    <section class="hub" id="hub" aria-labelledby="hub-title">
      <div class="shell">
        <div class="section-code"><span class="mono code-tag">§01</span><h2 id="hub-title" class="display">{t.hub.title}</h2></div>
        <p class="lede">{t.hub.intro}</p>

        <h3 class="sub-label mono">{t.hub.statCardsTitle}</h3>
        <div class="hub-grid">
          {t.hub.statCards.map((s, i) => (
            <article class="hub-card">
              <p class="mono card-index">D{String(i + 1).padStart(2, '0')}</p>
              <p class="hub-value mono">{s.value}</p>
              <p class="hub-label">{s.label}</p>
              <p class="hub-source mono">
                {s.sourceUrl ? <a href={s.sourceUrl} rel="noopener">{s.source}</a> : s.source}
                {s.asOf && <span> · {s.asOf}</span>}
              </p>
            </article>
          ))}
        </div>

        <div class="fig-row">
          <div class="fig-module">
            <div class="module-bar">
              <span class="mono">FIG. 01</span>
              <span class="mono">EUMOFA</span>
            </div>
            <div class="fig-body">
              <h3 class="fig-title">{t.hub.chart.title}</h3>
              <p class="fig-sub">{t.hub.chart.subtitle}</p>
              <LineChart
                data={euSelfSufficiency}
                locale={locale}
                yMin={30}
                yMax={50}
                yUnit="%"
                summary={`${t.hub.chart.title} — ${t.hub.chart.subtitle}`}
                tableLabel={chartTableLabel}
                yearLabel={chartYearLabel}
                valueLabel={chartValueLabel}
              >
                <span slot="caption">{t.hub.chart.sourceNote}</span>
              </LineChart>
            </div>
          </div>
          <div class="fig-module">
            <div class="module-bar">
              <span class="mono">FIG. 02</span>
              <span class="mono">FAO / BLUEINVEST</span>
            </div>
            <div class="fig-body">
              <h3 class="fig-title">{isPt ? 'Eficiência proteica — FCR' : 'Protein efficiency — FCR'}</h3>
              <p class="fig-sub">{isPt ? 'kg de ração por kg de proteína produzida' : 'kg of feed per kg of protein produced'}</p>
              <RangeBars
                rows={fcrRows}
                locale={locale}
                xMax={10}
                summary={isPt
                  ? 'Rácio de conversão alimentar por proteína: aquacultura 1,2–1,5; frango 1,7–2,0; suíno 2,7–5,0; bovino 6–10.'
                  : 'Feed conversion ratio by protein: aquaculture 1.2–1.5; chicken 1.7–2.0; pork 2.7–5.0; beef 6–10.'}
                unitNote={isPt ? 'Fonte: FAO / BlueInvest — intervalos típicos' : 'Source: FAO / BlueInvest — typical ranges'}
              />
            </div>
          </div>
        </div>

        <!-- Research slot (swappable module fed by /research) -->
        <aside class="observatory" aria-labelledby="obs-title" data-research-slot>
          <div class="module-bar module-bar--amber">
            <span class="mono" id="obs-title">{t.hub.researchSlot.title}</span>
            <span class="mono obs-updated">{t.hub.researchSlot.updatedLabel} {researchUpdated}</span>
          </div>
          <div class="obs-grid">
            {research.map((s, i) => (
              <article class="obs-card">
                <p class="mono card-index">R{String(i + 1).padStart(2, '0')}</p>
                <p class="obs-value mono">{s.value}</p>
                <p class="obs-label">{s.label}</p>
                <p class="obs-source mono"><a href={s.sourceUrl} rel="noopener">{s.report}</a> · {s.asOf}</p>
              </article>
            ))}
          </div>
          <p class="obs-note">{t.hub.researchSlot.note}</p>
        </aside>

        <h3 class="sub-label mono">{t.hub.resourcesTitle}</h3>
        <div class="resource-grid">
          {t.hub.resourceCards.map((c, i) => (
            <article class="resource-card">
              <p class="mono card-index">L{String(i + 1).padStart(2, '0')}</p>
              <h4>{c.title}</h4>
              <p>{c.description}</p>
              <ul class="resource-links">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                      {l.label} {l.external && <span aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE FUND ============ -->
    <section class="fund" id="fundo" aria-label={t.fund.sectionLabel}>
      <nav class="fund-subnav" aria-label={isPt ? 'Secções do fundo' : 'Fund sections'}>
        <div class="shell">
          <ul>
            {t.fund.subnav.map((s, i) => (
              <li><a href={s.anchor}><span class="mono subnav-idx">{String(i + 1).padStart(2, '0')}</span>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Thesis -->
      <article class="thesis" id="tese" aria-labelledby="thesis-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§02</span><h2 id="thesis-title" class="display">{t.fund.thesis.title}</h2></div>
          <div class="thesis-grid">
            {t.fund.thesis.paragraphs.map((p, i) => (
              <div class="thesis-p">
                <span class="mono thesis-idx">{String(i + 1).padStart(2, '0')}</span>
                <p>{p}</p>
              </div>
            ))}
          </div>
          <div class="equation" role="img" aria-label={`${t.fund.thesis.equation.blocks.join(' + ')} = ${t.fund.thesis.equation.result}`}>
            {t.fund.thesis.equation.blocks.map((b, i) => (
              <>
                <span class="eq-block">{b}</span>
                <span class="eq-op mono" aria-hidden="true">{i < 2 ? '+' : '='}</span>
              </>
            ))}
            <span class="eq-result">{t.fund.thesis.equation.result}</span>
          </div>

          <div class="eu-context">
            <h3 class="eu-title">{t.fund.euContext.title}</h3>
            <p class="eu-intro">{t.fund.euContext.intro}</p>
            <div class="eu-grid">
              {t.fund.euContext.stats.map((s) => (
                <div class="eu-stat">
                  <p class="eu-value mono">{s.value}</p>
                  <p class="eu-label">{s.label}</p>
                  <p class="eu-source mono">{s.source}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Verticals -->
      <article class="verticals" id="verticais" aria-labelledby="verticals-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§03</span><h2 id="verticals-title" class="display">{t.fund.verticals.title}</h2></div>
          <p class="lede">{t.fund.verticals.intro}</p>
          <div class="alloc-wrap">
            <AllocationStripe
              segments={allocSegments}
              summary={allocSegments.map((s) => `${s.label}: ${s.pct}% (${s.amount})`).join('; ')}
            />
          </div>
          <div class="chain" role="list">
            {t.fund.verticals.items.map((v, i) => (
              <>
                <section class="chain-node" role="listitem" aria-labelledby={`v-${v.number}`}>
                  <div class="module-bar">
                    <span class="mono">V{v.number}</span>
                    <span class="mono">{v.allocationLabel}</span>
                  </div>
                  <div class="chain-body">
                    <h3 id={`v-${v.number}`}>{v.title}</h3>
                    <p class="v-copy">{v.copy}</p>
                    <ul class="v-bullets">
                      {v.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                </section>
                {i < 2 && <span class="chain-arrow mono" aria-hidden="true">→</span>}
              </>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolio -->
      <article class="portfolio" id="portfolio" aria-labelledby="portfolio-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§04</span><h2 id="portfolio-title" class="display">{t.fund.portfolio.title}</h2></div>
          <div class="portfolio-grid">
            <div class="portfolio-body">
              <p class="anchor-tag mono">{t.fund.portfolio.anchorTag}</p>
              <h3 class="anchor-name">{t.fund.portfolio.anchorTitle}</h3>
              <p class="anchor-copy">{t.fund.portfolio.copy}</p>
              <table class="farm-sheet">
                <caption class="sr-only">{isPt ? 'Ficha técnica das quintas NaturaFish' : 'NaturaFish farm specification sheet'}</caption>
                <thead>
                  <tr>
                    <th scope="col" class="mono">{isPt ? 'Parâmetro' : 'Parameter'}</th>
                    <th scope="col" class="mono">Alvor</th>
                    <th scope="col" class="mono">Arade</th>
                  </tr>
                </thead>
                <tbody>
                  {farmSheet.map((row) => (
                    <tr>
                      <th scope="row">{row.param}</th>
                      <td class="mono">{row.alvor}</td>
                      <td class="mono">{row.arade}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="pipeline-note">{t.fund.portfolio.pipelineNote}</p>
            </div>
            <figure class="hero-module portfolio-module">
              <div class="module-bar">
                <span class="mono">FIG. 03</span>
                <span class="mono">ALVOR · ARADE</span>
              </div>
              <Picture
                src={photos.naturafishSquare}
                alt={t.fund.portfolio.imageAlt}
                widths={[480, 720, 1024]}
                sizes="(max-width: 980px) 100vw, 480px"
                formats={['avif', 'webp']}
                loading="lazy"
              />
              <figcaption class="module-caption mono">{heroCaption}</figcaption>
            </figure>
          </div>
        </div>
      </article>

      <!-- Structure & Terms -->
      <article class="terms" id="estrutura" aria-labelledby="terms-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§05</span><h2 id="terms-title" class="display">{t.fund.terms.title}</h2></div>
          <dl class="terms-table">
            {t.fund.terms.rows.map((r, i) => (
              <div class="terms-row">
                <dt><span class="mono card-index">T{String(i + 1).padStart(2, '0')}</span>{r.label}</dt>
                <dd>
                  <span class="terms-value mono">{r.value}</span>
                  {r.caveat && <span class="terms-caveat">{r.caveat}</span>}
                </dd>
              </div>
            ))}
          </dl>
          <p class="manager-line">{t.fund.terms.managerLine}</p>
          <p class="footnote">{t.fund.terms.irrCaveat}</p>
        </div>
      </article>

      <!-- Team -->
      <article class="team" id="equipa" aria-labelledby="team-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§06</span><h2 id="team-title" class="display">{t.fund.team.title}</h2></div>
          {t.fund.team.groups.map((g) => (
            <section class="team-group" aria-label={g.title}>
              <h3 class="sub-label mono">{g.title}</h3>
              <div class="team-grid">
                {g.members.map((m) => (
                  <article class="member">
                    {m.photo && teamPhotos[m.photo] ? (
                      <Image
                        class="member-photo"
                        src={teamPhotos[m.photo]!}
                        alt={m.name}
                        width={400}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    ) : (
                      <div class="member-pending" role="img" aria-label={`${m.name} — ${t.fund.team.photoPendingLabel}`}>
                        <span class="mono" aria-hidden="true">{t.fund.team.photoPendingLabel.toUpperCase()}</span>
                      </div>
                    )}
                    <h4 class="member-name">
                      {m.linkedIn ? <a href={m.linkedIn} rel="noopener">{m.name}</a> : m.name}
                    </h4>
                    <p class="member-role mono">{m.role}</p>
                    <p class="member-bio">{m.bio}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </article>

      <!-- Investment process -->
      <article class="process" id="investir" aria-labelledby="process-title">
        <div class="shell">
          <div class="section-code"><span class="mono code-tag">§07</span><h2 id="process-title" class="display">{t.fund.process.title}</h2></div>
          <p class="lede">{t.fund.process.intro}</p>
          <ol class="steps">
            {t.fund.process.steps.map((s, i) => (
              <li class="step">
                <span class="step-no mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.description}</p>
              </li>
            ))}
          </ol>
          <div class="invest-cta">
            <div class="contact-card">
              <p class="mono card-index">{isPt ? 'CONTACTO DIRECTO' : 'DIRECT CONTACT'}</p>
              <p class="contact-name">{t.fund.process.contact.name}</p>
              <p class="contact-role mono">{t.fund.process.contact.role}</p>
              <p class="contact-line mono"><a href={`mailto:${t.fund.process.contact.email}`}>{t.fund.process.contact.email}</a></p>
              <p class="contact-line mono"><a href={`tel:${t.fund.process.contact.phone.replace(/\s/g, '')}`}>{t.fund.process.contact.phone}</a></p>
              <p class="contact-line mono"><a href={`mailto:${t.fund.process.contact.generalEmail}`}>{t.fund.process.contact.generalEmail}</a></p>
            </div>
            <div class="cta-stack">
              <a class="btn btn-solid" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectCim}`}>{t.fund.process.ctaPrimary} <span aria-hidden="true">→</span></a>
              <a class="btn btn-outline" href={`mailto:${t.fund.process.contact.generalEmail}?subject=${mailSubjectMeet}`}>{t.fund.process.ctaSecondary} <span aria-hidden="true">→</span></a>
              <p class="cta-note">{t.fund.process.formNote}</p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Partners -->
    <section class="partners" aria-label={partnersTitle}>
      <div class="shell">
        <h2 class="sub-label mono">{partnersTitle}</h2>
        <ul class="partner-strip">
          {partners.map((p) => (
            <li>
              <Image src={p.image} alt={p.name} height={40} densities={[1, 2]} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        <Image src={brand.logoWhite} alt="STAG | btf. — blue transformation fund" width={200} densities={[1, 2]} loading="lazy" />
        <p class="footer-address">{t.footer.address}</p>
        <p class="footer-address">{t.footer.contactLine}</p>
      </div>
      <nav class="footer-links" aria-label={isPt ? 'Links legais' : 'Legal links'}>
        <ul>
          {t.footer.links.map((l) => (
            <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="shell">
      <p class="footer-disclaimer">{t.footer.disclaimer}</p>
      <p class="footer-copyright mono">{t.footer.copyright}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Tokens ===== */
  :global(body.alt-c) {
    --ice: #f4f8fb;
    --white: #ffffff;
    --ink: #0a1e38;
    --ink-soft: #3d5470;
    --ink-muted: #5a6e84;
    --navy: #0d3b6e;
    --blue: #1a5b9a;
    --amber: #c4830a;
    --amber-text: #8a5a04;
    --line: #d7e2ec;
    --line-strong: #b7c9d9;
    --font-head: 'Archivo Variable', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono Variable', ui-monospace, monospace;

    --chart-line: #1a5b9a;
    --chart-c1: #1a5b9a;
    --chart-c2: #008e9c;
    --chart-c3: #a96f06;
    --chart-ink: var(--ink);
    --chart-ink-muted: var(--ink-muted);
    --chart-grid: #e1eaf2;
    --chart-surface: var(--white);
    --chart-deemph: #9db0c2;
    --chart-font: var(--font-mono);

    background: var(--ice);
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 1rem;
  }

  .shell {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    border: 1px solid var(--line-strong);
    background: var(--white);
    padding: 0.45rem 0.8rem;
    border-radius: 2px;
  }
  .tick {
    width: 8px;
    height: 8px;
    background: var(--amber);
  }
  .display {
    font-family: var(--font-head);
    font-weight: 750;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .lede {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 64ch;
    margin-top: 1rem;
  }
  .sub-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 3rem 0 1.1rem;
  }
  .footnote {
    font-size: 0.74rem;
    color: var(--ink-muted);
    max-width: 74ch;
    margin-top: 0.9rem;
  }
  .card-index {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--amber-text);
  }
  .section-code {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding-top: clamp(3.2rem, 7vw, 5rem);
  }
  .code-tag {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--amber-text);
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-weight: 650;
    font-size: 0.92rem;
    text-decoration: none;
    border-radius: 2px;
    padding: 0.85rem 1.5rem;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .btn-solid {
    background: var(--navy);
    color: #fff;
  }
  .btn-solid:hover {
    background: var(--blue);
  }
  .btn-outline {
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--navy);
  }
  .btn-outline:hover {
    border-color: var(--navy);
  }

  /* ===== Header ===== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .logo-link img {
    width: clamp(132px, 15vw, 175px);
    height: auto;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    list-style: none;
    padding: 0;
    font-size: 0.88rem;
    font-weight: 550;
  }
  .nav-list a {
    text-decoration: none;
    color: var(--ink-soft);
    position: relative;
  }
  .nav-list a:hover {
    color: var(--navy);
  }
  .nav-list li:not(.nav-cta-item) a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }
  .nav-list li:not(.nav-cta-item) a:hover::after {
    transform: scaleX(1);
  }
  .nav-lang a {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--amber-text);
  }
  .nav-cta {
    background: var(--navy);
    color: #fff !important;
    padding: 0.55rem 1.05rem;
    border-radius: 2px;
    font-weight: 650;
  }
  .nav-cta:hover {
    background: var(--blue);
  }
  .nav-toggle {
    display: none;
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink);
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-toggle-bars i {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 1.5rem 1.25rem;
    }
    .main-nav[data-open='true'] .nav-list {
      display: flex;
    }
    .nav-list li {
      border-bottom: 1px solid var(--line);
    }
    .nav-list li:last-child {
      border-bottom: none;
    }
    .nav-list a {
      display: block;
      padding: 0.9rem 0.25rem;
    }
    .nav-cta {
      display: inline-block;
      margin-top: 0.9rem;
      text-align: center;
    }
    .nav-cta-item {
      border-bottom: none !important;
    }
  }

  /* ===== Hero ===== */
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(var(--ice), var(--ice)) padding-box,
      repeating-linear-gradient(90deg, transparent 0 119px, var(--line) 119px 120px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.6rem, 6vw, 4.6rem);
  }
  .hero-headline {
    margin-top: 1.4rem;
    font-family: var(--font-head);
    font-weight: 780;
    font-size: clamp(1.9rem, 4.6vw, 3.3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  .hero-headline .hl-1,
  .hero-headline .hl-2 {
    display: block;
  }
  .hero-headline .hl-2 {
    color: var(--blue);
    margin-top: 0.18em;
  }
  .hero-sub {
    margin-top: 1.3rem;
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 54ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }
  .hero-module {
    margin: 0;
    border: 1px solid var(--line-strong);
    background: var(--white);
  }
  .module-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }
  .module-bar--amber {
    border-bottom-color: var(--amber);
    background: #fdf6e9;
    color: var(--amber-text);
  }
  .hero-module img {
    width: 100%;
    height: auto;
  }
  .module-caption {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Stat readout */
  .stat-readout {
    border-top: 1px solid var(--line);
    background: var(--white);
    padding-block: 1.6rem 1.4rem;
  }
  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
  }
  .stat dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.4;
  }
  .stat dd {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    color: var(--navy);
    margin: 0.35rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .stat-band {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.4rem;
    }
  }

  /* ===== Hub ===== */
  .hub {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .hub-card {
    background: var(--white);
    padding: 1.2rem 1.1rem 1.1rem;
    position: relative;
    transition: background 0.15s ease;
  }
  .hub-card:hover {
    background: #fbfdff;
  }
  .hub-card:hover .card-index {
    color: var(--amber);
  }
  .hub-value {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--navy);
    margin-top: 0.5rem;
  }
  .hub-label {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .hub-source {
    font-size: 0.68rem;
    color: var(--ink-muted);
    margin-top: 0.7rem;
  }
  .hub-source a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }
  .hub-source a:hover {
    color: var(--amber-text);
  }
  @media (max-width: 980px) {
    .hub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
  }

  .fig-row {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1.2rem;
    margin-top: 2.4rem;
    align-items: start;
  }
  .fig-module {
    border: 1px solid var(--line-strong);
    background: var(--white);
  }
  .fig-body {
    padding: 1.2rem 1.3rem 1.3rem;
  }
  .fig-title {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .fig-sub {
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin: 0.35rem 0 1.1rem;
  }
  @media (max-width: 980px) {
    .fig-row {
      grid-template-columns: 1fr;
    }
  }

  /* Observatory / research slot */
  .observatory {
    margin-top: 2.4rem;
    border: 1px solid var(--amber);
    background: var(--white);
  }
  .obs-updated {
    color: var(--amber-text);
  }
  .obs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
  }
  .obs-card {
    background: var(--white);
    padding: 1.2rem 1.1rem;
  }
  .obs-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy);
    margin-top: 0.45rem;
  }
  .obs-label {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }
  .obs-source {
    font-size: 0.66rem;
    color: var(--ink-muted);
    margin-top: 0.55rem;
  }
  .obs-source a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }
  .obs-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--line);
    margin: 0;
  }
  @media (max-width: 880px) {
    .obs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .obs-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Resource cards */
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .resource-card {
    border: 1px solid var(--line);
    border-top: 2px solid var(--navy);
    background: var(--white);
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .resource-card h4 {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .resource-card p {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }
  .resource-links {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .resource-links a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--blue);
    text-decoration-color: var(--line-strong);
  }
  .resource-links a:hover {
    color: var(--amber-text);
  }
  @media (max-width: 880px) {
    .resource-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== Fund ===== */
  .fund {
    border-top: 1px solid var(--line);
    background: var(--white);
  }
  .fund-subnav {
    position: sticky;
    top: 55px;
    z-index: 40;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .fund-subnav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    padding: 0.65rem 0;
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .fund-subnav a {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-muted);
    white-space: nowrap;
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
  }
  .subnav-idx {
    font-size: 0.66rem;
    color: var(--amber-text);
  }
  .fund-subnav a:hover {
    color: var(--navy);
  }

  .thesis,
  .verticals,
  .portfolio,
  .terms,
  .team,
  .process {
    padding-bottom: clamp(3rem, 6vw, 4.6rem);
    scroll-margin-top: 108px;
  }
  .thesis,
  .portfolio,
  .team {
    background: var(--ice);
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.4rem, 3vw, 2.4rem);
    margin-top: 2.2rem;
  }
  .thesis-p {
    border-top: 1px solid var(--line-strong);
    padding-top: 1rem;
  }
  .thesis-idx {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--amber-text);
  }
  .thesis-p p {
    margin-top: 0.7rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  @media (max-width: 880px) {
    .thesis-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }

  .equation {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.8rem;
    margin-top: 2.6rem;
  }
  .eq-block {
    display: inline-flex;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 650;
    border: 1px solid var(--line-strong);
    background: var(--white);
    padding: 0.8rem 1.1rem;
  }
  .eq-op {
    display: inline-flex;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--amber-text);
  }
  .eq-result {
    display: inline-flex;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 700;
    background: var(--navy);
    color: #fff;
    padding: 0.8rem 1.2rem;
  }

  .eu-context {
    margin-top: clamp(2.6rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    padding-top: 2.2rem;
  }
  .eu-title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 750;
    max-width: 32ch;
  }
  .eu-intro {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    max-width: 64ch;
    line-height: 1.6;
  }
  .eu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 1.8rem;
  }
  .eu-stat {
    background: var(--white);
    padding: 1.2rem 1.1rem;
  }
  .eu-value {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    color: var(--amber-text);
  }
  .eu-label {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }
  .eu-source {
    font-size: 0.66rem;
    color: var(--ink-muted);
    margin-top: 0.5rem;
  }
  @media (max-width: 820px) {
    .eu-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Verticals — value chain schematic */
  .alloc-wrap {
    margin-top: 2rem;
    max-width: 48rem;
  }
  .chain {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0.9rem;
    align-items: stretch;
    margin-top: 2.4rem;
  }
  .chain-node {
    border: 1px solid var(--line-strong);
    background: var(--white);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .chain-node:hover {
    border-color: var(--navy);
    box-shadow: 0 4px 18px rgba(13, 59, 110, 0.08);
  }
  .chain-body {
    padding: 1.2rem 1.3rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
  }
  .chain-body h3 {
    font-size: 1.15rem;
    font-weight: 750;
  }
  .v-copy {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .v-bullets {
    list-style: none;
    padding: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .v-bullets li {
    padding-left: 1rem;
    position: relative;
    line-height: 1.45;
  }
  .v-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--amber);
    font-weight: 700;
  }
  .chain-arrow {
    display: flex;
    align-items: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--amber-text);
  }
  @media (max-width: 980px) {
    .chain {
      grid-template-columns: 1fr;
    }
    .chain-arrow {
      justify-content: center;
      transform: rotate(90deg);
      padding: 0.2rem 0;
    }
  }

  /* Portfolio */
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(1.8rem, 4vw, 3rem);
    margin-top: 2.2rem;
    align-items: start;
  }
  .anchor-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber-text);
  }
  .anchor-name {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 780;
    margin-top: 0.5rem;
  }
  .anchor-copy {
    margin-top: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .farm-sheet {
    width: 100%;
    max-width: 34rem;
    border-collapse: collapse;
    margin-top: 1.6rem;
    background: var(--white);
    border: 1px solid var(--line-strong);
    font-size: 0.85rem;
  }
